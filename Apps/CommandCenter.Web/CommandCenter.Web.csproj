<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The hosted-agent endpoint names a specific tenant, so it belongs in user secrets rather
         than in a committed appsettings file. -->
    <UserSecretsId>caesarea-commandcenter-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Caesarea.ServiceDefaults\Caesarea.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Shared\CanonicalModel\Caesarea.CanonicalModel.csproj" />
    <ProjectReference Include="..\..\Contracts\CommandCenter.Contracts\CommandCenter.Contracts.csproj" />
    <ProjectReference Include="..\..\Contracts\Energy.Contracts\Energy.Contracts.csproj" />
    <ProjectReference Include="..\..\Contracts\DemoScenario.Contracts\DemoScenario.Contracts.csproj" />
    <ProjectReference Include="..\..\Contracts\OperationsAgent.Contracts\OperationsAgent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Caesarea.Deterministic.Tests" />
  </ItemGroup>

</Project>
