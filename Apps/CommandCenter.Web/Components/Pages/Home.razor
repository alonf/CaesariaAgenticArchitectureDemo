@page "/"
@implements IAsyncDisposable
@inject CommandCenterApiClient ApiClient
@inject OperationsAgentApiClient OperationsAgentClient
@inject HostedOperationsAgentClient HostedAgentClient
@inject IConfiguration Configuration
@inject IOptions<CommandCenterWebOptions> WebOptions
@inject IJSRuntime JS

<PageTitle>Caesarea City Command Center</PageTitle>

<div class="command-center">
    <header class="command-bar">
        <div class="brand">
            <div class="city-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48">
                    <path d="M7 38h34M11 38V19l13-9 13 9v19M18 38V27h12v11M8 20h32" />
                </svg>
            </div>
            <div>
                <span class="brand-kicker">Caesarea Smart City</span>
                <h1>Command &amp; Control Center</h1>
            </div>
        </div>

        <div class="command-status">
            <div class="status-clock">
                <span>@DateTimeOffset.Now.ToString("dd MMM yyyy")</span>
                @* The dashboard renders local time while an agent answer quotes UTC with a
                   trailing Z. Naming the offset keeps the two readable side by side - they can
                   show the same digits hours apart. *@
                <strong>@DateTimeOffset.Now.ToString("HH:mm") <span class="clock-zone">@LocalZoneLabel</span></strong>
            </div>
            <span class="system-pill healthy"><i></i> Systems operational</span>
            <span class="operator-badge">OP</span>
        </div>
    </header>

    <nav class="workspace-tabs" aria-label="Command Center workspaces">
        <button class="workspace-tab active">Operations Overview</button>
        <button class="workspace-tab">Customer Reports <span class="tab-count">@CustomerReportCount</span></button>
        <button class="workspace-tab">Incidents <span class="tab-count">@IncidentCount</span></button>
        <button class="workspace-tab">Assets</button>
        <button class="workspace-tab">Activity</button>
        <span class="stage-chip">@StageName stage</span>
        @* The script lives in a panel the presenter opens, not inline in the operator's view. *@
        @if (_snapshot?.CurrentStage.Walkthrough is not null)
        {
            <button class="walkthrough-toggle @(_showWalkthrough ? "active" : string.Empty)"
                    @onclick="ToggleWalkthroughAsync"
                    aria-expanded="@_showWalkthrough">
                @(_showWalkthrough ? "Hide walkthrough" : "Walkthrough")
            </button>
        }
    </nav>

    @if (_showWalkthrough && _snapshot?.CurrentStage.Walkthrough is { } walkthrough)
    {
        <aside class="walkthrough-panel" aria-label="Stage walkthrough">
            <div class="walkthrough-heading">
                <strong>@StageName</strong>
                <button class="walkthrough-close" @onclick="() => _showWalkthrough = false" aria-label="Close walkthrough">&times;</button>
            </div>

            @if (walkthrough.Prerequisites.Count > 0)
            {
                <small>Needs</small>
                <ul class="walkthrough-prereqs">
                    @foreach (var prerequisite in walkthrough.Prerequisites)
                    {
                        var (mark, markClass) = PrerequisiteMark(prerequisite);
                        <li class="@markClass"><span class="walkthrough-mark" aria-hidden="true">@mark</span><span>@prerequisite.Text</span></li>
                    }
                </ul>
            }

            <small>Steps</small>
            <ol class="walkthrough-steps">
                @foreach (var step in walkthrough.Steps)
                {
                    <li>
                        <span class="walkthrough-surface @SurfaceClass(step.Surface)">@SurfaceLabel(step.Surface)</span>
                        <span class="walkthrough-action">@step.Action</span>
                        @if (!string.IsNullOrWhiteSpace(step.Expect))
                        {
                            <span class="walkthrough-expect">@step.Expect</span>
                        }
                    </li>
                }
            </ol>

            <small>The point</small>
            <p class="walkthrough-point">@walkthrough.Point</p>
        </aside>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <section class="message-banner @(_messageIsError ? "error" : "success")">
            <strong>@(_messageIsError ? "Action required" : "Operation complete")</strong>
            <span>@_message</span>
        </section>
    }

    @if (_snapshot is null)
    {
        <section class="loading-state">
            <div class="loading-pulse"></div>
            <div>
                <strong>Establishing operational picture</strong>
                <span>Loading authoritative state from the Energy Hub...</span>
            </div>
        </section>
    }
    else
    {
        <main class="operations-grid @(IsAgentStage ? "with-investigation" : string.Empty)">
            <aside class="left-rail">
                <section class="rail-section">
                    <div class="section-title">
                        <span>City domains</span>
                        <small>3 hubs</small>
                    </div>

                    <button class="hub-row active">
                        <span class="hub-icon energy-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="m13 2-8 12h6l-1 8 8-12h-6l1-8Z" /></svg>
                        </span>
                        <span class="hub-copy">
                            <strong>Energy Hub</strong>
                            <small>Connected · 1 monitored asset</small>
                        </span>
                        <span class="hub-state healthy"></span>
                    </button>

                    <button class="hub-row">
                        <span class="hub-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6l-8-3Z" /></svg>
                        </span>
                        @* The Security domain becomes a live participant at the MultiAgent stage,
                           where its own agent is consulted across the boundary. Before that it only
                           contributes the operational context the Energy twin carries. *@
                        @* "Consulted" is a claim about something that happened, so it is shown only
                           when the last answer actually carries a completed delegation - the stage
                           being active, or the presenter's consult toggle, is not the same thing. *@
                        <span class="hub-copy">
                            <strong>Security Hub</strong>
                            <small>@SecurityHubStatusText</small>
                        </span>
                        <span class="hub-state @(SecurityWasConsulted ? "healthy" : "muted")"></span>
                    </button>

                    <button class="hub-row">
                        <span class="hub-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M5 17h14M7 17l1-8h8l1 8M9 9V6h6v3M8 20h.01M16 20h.01" /></svg>
                        </span>
                        <span class="hub-copy">
                            <strong>Mobility Hub</strong>
                            <small>Not connected in this demo</small>
                        </span>
                        <span class="hub-state muted"></span>
                    </button>
                </section>

                <section class="rail-section">
                    <div class="section-title">
                        <span>Operational summary</span>
                        <small>Live</small>
                    </div>
                    <div class="metric-list">
                        <div class="metric-row">
                            <span>Monitored assets</span>
                            <strong>1</strong>
                        </div>
                        <div class="metric-row">
                            <span>Assets requiring attention</span>
                            <strong class="@AttentionClass">@AttentionCount</strong>
                        </div>
                        <div class="metric-row">
                            <span>Open incidents</span>
                            <strong class="@IncidentClass">@IncidentCount</strong>
                        </div>
                        <div class="metric-row">
                            <span>Events in timeline</span>
                            <strong>@_snapshot.RecentActivity.Count</strong>
                        </div>
                    </div>
                </section>

                <section class="rail-section selected-asset">
                    <div class="section-title">
                        <span>Selected asset</span>
                        <small>@_snapshot.Area</small>
                    </div>
                    <div class="asset-identity">
                        <span class="lamp-symbol @LampClass" aria-hidden="true">
                            <svg viewBox="0 0 32 48">
                                <path d="M11 44h10M16 44V12c0-4 3-7 7-7h4M22 5h7v8h-7z" />
                            </svg>
                        </span>
                        <div>
                            <strong>@_snapshot.AssetId</strong>
                            <span>Promenade streetlight</span>
                        </div>
                    </div>
                    <dl class="compact-facts">
                        <div><dt>Reported</dt><dd class="@LampClass">@OnOff(_snapshot.OperationalState.ReportedIsOn)</dd></div>
                        <div><dt>Schedule</dt><dd>@OnOff(_snapshot.OperationalState.ExpectedScheduledState)</dd></div>
                        @* The effective target outranks the schedule when an operation requires
                           lighting; showing both makes the security-operation beat visible. *@
                        <div><dt>Effective target</dt><dd>@OnOff(_snapshot.OperationalState.EffectiveTargetIsOn)</dd></div>
                        <div><dt>Health</dt><dd class="@HealthClass">@_snapshot.OperationalState.ControllerHealth.Status</dd></div>
                    </dl>
                </section>
            </aside>

            <section class="map-workspace">
                <div class="map-toolbar">
                    <div>
                        <span class="section-eyebrow">Live operational map</span>
                        <h2>@_snapshot.MapLabel</h2>
                    </div>
                    <div class="map-actions">
                        <span class="updated-label">Updated @FormatTimestamp(_lastRefreshed)</span>
                        <button class="icon-button" title="Refresh operational state" @onclick="RefreshAsync" disabled="@_busy">
                            <svg viewBox="0 0 24 24"><path d="M20 6v5h-5M4 18v-5h5M6.1 9A7 7 0 0 1 18 6l2 5M17.9 15A7 7 0 0 1 6 18l-2-5" /></svg>
                        </button>
                    </div>
                </div>

                <div class="city-map">
                    <svg class="map-drawing" viewBox="0 0 900 610" preserveAspectRatio="none" aria-label="Stylized map of the North Promenade">
                        <path class="sea" d="M0 0h255c37 76 22 146 72 210 46 59 22 122 69 185 40 54 32 136 88 215H0Z" />
                        <path class="coastline" d="M255 0c37 76 22 146 72 210 46 59 22 122 69 185 40 54 32 136 88 215" />
                        <path class="primary-road" d="M330-20c37 90 30 157 79 229 45 67 36 129 80 197 34 53 40 113 80 224" />
                        <path class="road" d="M419 105 880 36M389 216l511 22M446 339l454 80M493 462l407 132M550 0l-43 610M700 0l-48 610M830 0l-30 610" />
                        <path class="road minor" d="m490 70 390 63M460 277l420 63M510 399l370 75M590 0l-31 610M760 0l-40 610" />
                        <g class="city-blocks">
                            <path d="m459 117 82-13-3 69-79 8Z" /><path d="m568 99 96-14-5 78-90 8Z" />
                            <path d="m692 78 95-15-4 91-88 7Z" /><path d="m471 236 84 5-5 71-72-10Z" />
                            <path d="m587 246 94 8-8 71-88-11Z" /><path d="m713 257 91 8-7 78-88-15Z" />
                            <path d="m508 357 77 13-2 69-68-13Z" /><path d="m615 379 91 17-7 68-85-19Z" />
                            <path d="m744 403 78 17-10 70-73-20Z" /><path d="m557 479 75 19-2 70-70-22Z" />
                            <path d="m661 510 81 24-6 62-76-22Z" />
                        </g>
                    </svg>

                    <div class="map-label promenade-label">North Promenade</div>
                    <div class="map-label sea-label">Mediterranean Sea</div>

                    <button class="asset-marker @MarkerClass" style="left: 48%; top: 41%;" aria-label="Select streetlight L-417">
                        <span class="marker-pulse"></span>
                        <span class="marker-icon">
                            <svg viewBox="0 0 24 24"><path d="M9 21h6M12 21V7c0-2.2 1.8-4 4-4h4M17 3h4v5h-4z" /></svg>
                        </span>
                        <span class="marker-card">
                            <strong>@_snapshot.AssetId</strong>
                            <small>@OnOff(_snapshot.OperationalState.ReportedIsOn) · @AssetCondition</small>
                        </span>
                    </button>

                    @if (_snapshot.CustomerReport is { } customerReport)
                    {
                        <article class="customer-report-pin" style="left: 52%; top: 48%;">
                            <svg class="report-arrow" viewBox="0 0 110 90" aria-hidden="true">
                                <path d="M104 84C82 70 60 45 18 16" />
                                <path d="m20 31-4-17 18 2" />
                            </svg>
                            <img src="@customerReport.ImageUrl" alt="Customer photo showing streetlight L-417 illuminated during daylight" />
                            <div class="report-copy">
                                <span class="report-label"><i></i> Incoming customer report</span>
                                <blockquote>“@customerReport.Message”</blockquote>
                                <small>@customerReport.Source · @FormatTimestamp(customerReport.ReceivedAt)</small>
                                <button class="report-resolve" @onclick="() => ResolveReportAsync(customerReport.Id)" disabled="@_busy">
                                    Mark resolved
                                </button>
                            </div>
                        </article>
                    }

                    <span class="context-marker" style="left: 72%; top: 23%;" title="Security context">
                        <svg viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6l-8-3Z" /></svg>
                    </span>

                    <div class="map-legend">
                        <span><i class="legend-dot healthy"></i> Normal</span>
                        <span><i class="legend-dot warning"></i> Attention</span>
                        <span><i class="legend-dot muted"></i> Context only</span>
                    </div>
                </div>

                <section class="event-strip">
                    <div class="event-summary">
                        <span class="section-eyebrow">Current operational question</span>
                        <strong>@CurrentOperationalQuestion</strong>
                    </div>
                    <div class="event-facts">
                        <div><span>Observed</span><strong>@OnOff(_snapshot.OperationalState.ReportedIsOn)</strong></div>
                        <div><span>Schedule</span><strong>@OnOff(_snapshot.OperationalState.ExpectedScheduledState)</strong></div>
                        <div><span>Effective target</span><strong>@OnOff(_snapshot.OperationalState.EffectiveTargetIsOn)</strong></div>
                        <div><span>Override</span><strong>@YesNo(_snapshot.OperationalState.ManualOverride)</strong></div>
                    </div>
                </section>
            </section>

            <aside class="right-rail">
                <section class="incident-panel @IncidentPanelClass">
                    <div class="section-title">
                        <span>Active incident</span>
                        <span class="severity-badge">@IncidentSeverityText</span>
                    </div>

                    @if (_snapshot.OpenIncident is null)
                    {
                        <div class="incident-empty">
                            <span class="incident-symbol">
                                <svg viewBox="0 0 24 24"><path d="m12 3 9 17H3L12 3Zm0 6v5m0 3h.01" /></svg>
                            </span>
                            <strong>No incident created</strong>
                            @* Two different reasons for an empty panel: nothing is wrong, or
                               something is and no one has opened a record for it. Before the agent
                               arrives, that second case is the whole point of the stage. *@
                            <p>@IncidentEmptyExplanation</p>
                        </div>
                    }
                    else
                    {
                        <div class="incident-record">
                            <span class="incident-id">@_snapshot.OpenIncident.Id</span>
                            <h3>@_snapshot.OpenIncident.Title</h3>
                            <p>@_snapshot.OpenIncident.Description</p>
                            <dl class="incident-facts">
                                <div><dt>Status</dt><dd>@_snapshot.OpenIncident.Status</dd></div>
                                <div><dt>Severity</dt><dd>@_snapshot.OpenIncident.Severity</dd></div>
                                <div><dt>Asset</dt><dd>@_snapshot.OpenIncident.AssetId</dd></div>
                                <div><dt>Opened</dt><dd>@FormatTimestamp(_snapshot.OpenIncident.CreatedAt)</dd></div>
                            </dl>
                        </div>
                    }
                </section>

                <section class="workflow-panel">
                    <div class="section-title">
                        <span>Operator workflow</span>
                        <small>Deterministic</small>
                    </div>
                    <div class="workflow-steps">
                        <div class="workflow-step complete"><i>1</i><span><strong>Detect state</strong><small>Energy Hub reports the lamp state</small></span></div>
                        <div class="workflow-step current"><i>2</i><span><strong>Assess anomaly</strong><small>Compare reported state with schedule</small></span></div>
                        <div class="workflow-step"><i>3</i><span><strong>Execute action</strong><small>Restore the scheduled mode</small></span></div>
                    </div>
                    <button class="action-button @(_busy ? "busy" : string.Empty)" @onclick="RestoreScheduledModeAsync" disabled="@_busy">
                        <span>@(_busy ? "Executing workflow..." : "Restore Scheduled Mode")</span>
                        <svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
                    </button>
                    <p class="workflow-note">This action follows the predefined Energy Hub workflow. It does not explain the cause.</p>
                </section>

                <section class="timeline-panel">
                    <div class="section-title">
                        <span>Live event stream</span>
                        <small>@_snapshot.RecentActivity.Count events</small>
                    </div>
                    <ol class="timeline">
                        @if (_snapshot.RecentActivity.Count == 0)
                        {
                            <li class="timeline-empty">No activity recorded for this scenario.</li>
                        }
                        @foreach (var activity in _snapshot.RecentActivity.Take(6))
                        {
                            <li class="timeline-item">
                                <span class="timeline-dot @(activity.IsSuccess ? "healthy" : "warning")"></span>
                                <div>
                                    <div class="timeline-heading">
                                        <strong>@activity.Kind</strong>
                                        <time>@FormatTimestamp(activity.OccurredAt)</time>
                                    </div>
                                    <p>@activity.Message</p>
                                    <small>@activity.Source · @ShortCorrelation(activity.CorrelationId)</small>
                                </div>
                            </li>
                        }
                    </ol>
                </section>
            </aside>

            @if (IsAgentStage)
            {
                <aside class="investigation-rail">
                    <section class="investigation-panel">
                        <div class="section-title">
                            <span>Caesarea Operations Agent</span>
                            @if (IsHostingStage)
                            {
                                <span class="agent-status-badge @(HostedHabitatSelected ? "success" : "idle")">@(HostedHabitatSelected ? "Foundry-hosted" : "Local habitat")</span>
                            }
                            <span class="agent-status-badge @AgentStatusClass">@AgentStatusText</span>
                        </div>

                        <div class="agent-identity">
                            <span class="agent-avatar" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M12 2a5 5 0 0 1 5 5v1a5 5 0 0 1-10 0V7a5 5 0 0 1 5-5Zm-7 19a7 7 0 0 1 14 0Z" /></svg>
                            </span>
                            <div>
                                @if (HostedHabitatSelected)
                                {
                                    <strong>Caesarea Operations Agent (hosted)</strong>
                                    <small>Same code, Foundry runtime · Work IQ asks as you</small>
                                }
                                else
                                {
                                    <strong>@(_agentResponse?.AgentName ?? "Caesarea Operations Agent")</strong>
                                    <small>General operations assistant · one Energy Hub tool</small>
                                }
                            </div>
                        </div>

                        <div class="agent-summary">
                            <small>Operator question</small>
                            <p>@AgentQuestion</p>
                        </div>

                        <button class="action-button investigate-button @ActionBusyClass(AgentAction.Ask)" @onclick="AskAgentAsync" disabled="@AgentActionsBusy">
                            <span>@(IsRunning(AgentAction.Ask) ? "Asking..." : "Ask agent")</span>
                            <svg viewBox="0 0 24 24"><path d="M11 4a7 7 0 1 0 4.9 12.1l4.5 4.5 1.4-1.4-4.5-4.5A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" /></svg>
                        </button>

                        @AgentOutcome(AgentAction.Ask)

                        @if (_activeAction is null)
                        {
                            <p class="agent-empty">Ask the general agent whether L-417 is currently on.</p>
                        }

                        <div class="rail-actions @(_showEarlierActions ? string.Empty : "hide-earlier")">
                        @* Provenance over convenience: every button below drives the LOCAL agent
                           and its local state, so while the habitat is FOUNDRY HOSTED they are
                           disabled rather than left to produce answers the badge would mislabel. *@
                        @if (HostedHabitatSelected)
                        {
                            <p class="agent-footnote">
                                Habitat is FOUNDRY HOSTED: only "Ask agent" and the work-records question route to the
                                hosted agent. The earlier stages' beats run the local agent - flip Habitat to LOCAL on
                                the switchboard to use them.
                            </p>
                        }
                        @if (IsSessionStage && _agentSessionId is not null)
                        {
                            <div class="@FollowUpRailClass">
                            <button class="action-button investigate-button @ActionBusyClass(AgentAction.FollowUp)" @onclick="AskFollowUpAsync" disabled="@LocalAgentActionsDisabled">
                                <span>@(IsRunning(AgentAction.FollowUp) ? "Asking..." : "Ask \"Why?\" (same session)")</span>
                                <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9h-2a7 7 0 1 1-7-7v3l5-4-5-4Z" /></svg>
                            </button>

                            @AgentOutcome(AgentAction.FollowUp)
                            <p class="agent-footnote">
                                Session @ShortCorrelation(_agentSessionId) - conversational context, never authoritative state.
                            </p>
                            </div>
                        }

                        @if (IsSkillsStage)
                        {
                            <div class="@RailActionClass(DemoStage.Skills)">
                            <button class="action-button investigate-button @ActionBusyClass(AgentAction.Investigate)" @onclick="InvestigateAsync" disabled="@LocalAgentActionsDisabled">
                                <span>@(IsRunning(AgentAction.Investigate) ? "Investigating..." : $"Investigate {_snapshot.AssetId} (new session)")</span>
                                <svg viewBox="0 0 24 24"><path d="M9 3h6l1 4h4l-2 6h-4l-1 8h-2l-1-8H6L4 7h4l1-4Z" /></svg>
                            </button>

                            @AgentOutcome(AgentAction.Investigate)
                            </div>
                        }

                        @if (IsInteractiveStage)
                        {
                            <div class="@RailActionClass(DemoStage.InteractiveInput)">
                            <button class="action-button investigate-button @ActionBusyClass(AgentAction.Restore)" @onclick="RestoreViaAgentAsync" disabled="@LocalAgentActionsDisabled">
                                <span>@(IsRunning(AgentAction.Restore) ? "Working..." : $"Restore {_snapshot.AssetId} to scheduled mode (agent)")</span>
                                <svg viewBox="0 0 24 24"><path d="M12 5V2L8 6l4 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7Z" /></svg>
                            </button>

                            @AgentOutcome(AgentAction.Restore)
                            </div>
                        }

                        @if (IsWorkflowStage)
                        {
                            <div class="@RailActionClass(DemoStage.Workflow)">
                            <button class="action-button investigate-button @(_workflowBusy ? "busy" : string.Empty)" @onclick="RunWorkflowAsync" disabled="@(_workflowBusy || HostedHabitatSelected)">
                                <span>@(_workflowBusy ? "Workflow running..." : $"Run remediation workflow for {_snapshot.AssetId}")</span>
                                <svg viewBox="0 0 24 24"><path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm13 0v3h-4v3h7v-6h-3Z" /></svg>
                            </button>
                            </div>
                        }

                        @if (IsToolApprovalStage)
                        {
                            <div class="@RailActionClass(DemoStage.ToolApproval)">
                            <button class="action-button investigate-button @ActionBusyClass(AgentAction.Maintenance)" @onclick="RequestMaintenanceAsync" disabled="@LocalAgentActionsDisabled">
                                <span>@(IsRunning(AgentAction.Maintenance) ? "Working..." : $"Investigate the reported controller fault on {_snapshot.AssetId}")</span>
                                <svg viewBox="0 0 24 24"><path d="M14 7a4 4 0 0 0-5.5 4.9l-4.6 4.6 2.6 2.6 4.6-4.6A4 4 0 0 0 17 9.5L14.5 12 12 9.5 14.5 7Z" /></svg>
                            </button>

                            @AgentOutcome(AgentAction.Maintenance)
                            </div>
                        }

                        @* The stage's question is "why is it on?", not "is it on?" - only the
                           first can require the other domain's judgment, so the beat has its own
                           button instead of depending on the model volunteering a consult. *@
                        @if (IsMultiAgentStage)
                        {
                            <div class="@RailActionClass(DemoStage.MultiAgent)">
                            <button class="action-button investigate-button @ActionBusyClass(AgentAction.Security)" @onclick="AssessSecuritySituationAsync" disabled="@LocalAgentActionsDisabled">
                                <span>@(IsRunning(AgentAction.Security) ? "Asking..." : $"Why is {_snapshot.AssetId} on during daylight? (new session)")</span>
                                <svg viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6l-8-3Z" /></svg>
                            </button>

                            @AgentOutcome(AgentAction.Security)
                            </div>
                        }

                        @* Two buttons, because the beat is a pair: the question the peer answers,
                           and the question it cannot. The second is not a refusal to demonstrate -
                           it is what "the field never entered its context" sounds like out loud. *@
                        @if (IsA2ADelegationStage)
                        {
                            <div class="@RailActionClass(DemoStage.A2ADelegation)">
                            <button class="action-button investigate-button @ActionBusyClass(AgentAction.WorkforceAsset)" @onclick="ConsultWorkforceAboutAssetAsync" disabled="@LocalAgentActionsDisabled">
                                <span>@(IsRunning(AgentAction.WorkforceAsset) ? "Consulting..." : $"Ask the workforce domain about {_snapshot.AssetId}")</span>
                                <svg viewBox="0 0 24 24"><path d="M7 4a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm10 0a3 3 0 1 1 0 6 3 3 0 0 1 0-6ZM2 20v-2a5 5 0 0 1 5-5h1l-1 3 1 4H2Zm14 0 1-4-1-3h1a5 5 0 0 1 5 5v2h-6Z" /></svg>
                            </button>

                            @AgentOutcome(AgentAction.WorkforceAsset)
                            <button class="action-button investigate-button @ActionBusyClass(AgentAction.WorkforceCost)" @onclick="ConsultWorkforceAboutCostAsync" disabled="@LocalAgentActionsDisabled">
                                <span>@(IsRunning(AgentAction.WorkforceCost) ? "Consulting..." : "Ask the workforce domain for the technician and labour cost")</span>
                                <svg viewBox="0 0 24 24"><path d="M12 2a5 5 0 0 0-5 5v2H6v11h12V9h-1V7a5 5 0 0 0-5-5Zm0 2a3 3 0 0 1 3 3v2H9V7a3 3 0 0 1 3-3Zm0 9a2 2 0 0 1 1 3.7V18h-2v-1.3A2 2 0 0 1 12 13Z" /></svg>
                            </button>

                            @AgentOutcome(AgentAction.WorkforceCost)
                            </div>
                        }

                        @if (_pendingApprovals.Count > 0)
                        {
                            <div class="agent-summary approval-panel">
                                <small>Operator input required</small>
                                @foreach (var approval in _pendingApprovals)
                                {
                                    <p class="approval-message">@approval.Message</p>
                                    @* The capability and its arguments come from the request, so
                                       the operator sees exactly what they are approving. *@
                                    @if (!string.IsNullOrWhiteSpace(approval.ToolName))
                                    {
                                        @* One row per argument. Joining them into a sentence would
                                           let a model-authored value read as another argument, and
                                           an approval given against that is not informed. *@
                                        <dl class="approval-capability">
                                            <div><dt>Capability</dt><dd>@approval.ToolName</dd></div>
                                            @foreach (var argument in approval.ToolArguments ?? [])
                                            {
                                                <div><dt>@argument.Name</dt><dd>@argument.Value</dd></div>
                                            }
                                        </dl>
                                    }
                                    <div class="approval-actions">
                                        <button class="action-button approval-approve" @onclick="() => RespondToApprovalAsync(approval.Id, true)" disabled="@_approvalBusy">Approve</button>
                                        <button class="action-button approval-deny" @onclick="() => RespondToApprovalAsync(approval.Id, false)" disabled="@_approvalBusy">Deny</button>
                                    </div>
                                    @* Each request states which control point raised it - that
                                       distinction is the whole lesson of stages 7 to 9. *@
                                    <p class="agent-footnote">@ApprovalFootnote(approval)</p>
                                }
                            </div>
                        }

                        @if (IsWorkflowStage && _workflowRun is { } workflowRun)
                        {
                            <div class="agent-summary wfrun-panel">
                                <small>Remediation workflow run</small>
                                <ol class="wfrun-steps">
                                    @foreach (var step in workflowRun.Steps)
                                    {
                                        <li class="wfrun-step @step.Status.ToLowerInvariant()">
                                            <div class="wfrun-step-head">
                                                <span class="wfrun-step-node">@step.ExecutorId</span>
                                                <span class="wfrun-step-status">@step.Status</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(step.Detail))
                                            {
                                                <p class="wfrun-step-detail">@step.Detail</p>
                                            }
                                        </li>
                                    }
                                </ol>
                                @if (workflowRun.Completed)
                                {
                                    @* Colored by verified resolution, never by "a command ran": an executed
                                       correction that left the asset wrong is not a success. *@
                                    <p class="wfrun-outcome @WorkflowOutcomeClass(workflowRun)">
                                        <span class="wfrun-outcome-status">@workflowRun.Status</span>
                                        @workflowRun.Summary
                                    </p>
                                    @if (!workflowRun.Resolved && workflowRun.CommandExecuted)
                                    {
                                        <p class="wfrun-step-detail">A command did change the asset, but verification says it is still not in its effective target state.</p>
                                    }
                                }
                            </div>
                        }

                        @if (IsWorkflowStage && !string.IsNullOrWhiteSpace(_workflowMessage))
                        {
                            <p class="agent-footnote">@_workflowMessage</p>
                        }

                        @* The generated diagram teaches the Workflow stage. Once the demo has moved
                           on and no run is on screen, it is a large panel describing remediation
                           that the situation in front of the operator has nothing to do with. *@
                        @if (WorkflowDefinitionIsRelevant && _workflowDefinition is not null)
                        {
                            <div class="agent-summary wfrun-definition">
                                <small>Workflow definition</small>
                                <div class="wfrun-tabs">
                                    <button class="wfrun-tab @(_workflowTab == "diagram" ? "active" : string.Empty)" @onclick='() => SelectWorkflowTab("diagram")'>Graph (generated)</button>
                                    <button class="wfrun-tab @(_workflowTab == "yaml" ? "active" : string.Empty)" @onclick='() => SelectWorkflowTab("yaml")'>Declarative YAML</button>
                                </div>
                                <div id="workflow-diagram" class="wfrun-diagram" hidden="@(_workflowTab != "diagram")"></div>
                                <pre class="wfrun-yaml" hidden="@(_workflowTab != "yaml")">@_workflowDefinition.Yaml</pre>
                                <p class="agent-footnote">The diagram is generated from the code-built graph; the YAML is the equivalent declarative form - displayed, not executed.</p>
                            </div>
                        }

                        @if (IsMemoryStage)
                        {
                            <div class="@RailActionClass(DemoStage.Memory)">
                                @* The symptom is read from the snapshot on screen, so closing a case
                                   for a different asset than the one displayed would file one
                                   asset's identifier against another asset's state. *@
                                @if (_agentResponse is not null && CaseMatchesDisplayedAsset)
                                {
                                    <button class="action-button investigate-button @CloseCaseStateClass" @onclick="CloseCaseAsync" disabled="@(LocalAgentActionsDisabled || _caseBusy || _caseClosed)">
                                        <span>@CloseCaseLabel</span>
                                        <svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4Z" /></svg>
                                    </button>
                                }
                                else if (_agentResponse is not null && _snapshot is { } caseSnapshot)
                                {
                                    <p class="agent-footnote">
                                        Closing a case records the state on screen, so it applies to @caseSnapshot.AssetId -
                                        the last question was about @(QuestionedAssetId ?? "another asset"). Select that asset to close its case.
                                    </p>
                                }

                                <button class="action-button investigate-button @ActionBusyClass(AgentAction.SecondAsset)" @onclick="AskSecondAssetAsync" disabled="@LocalAgentActionsDisabled">
                                    <span>@(IsRunning(AgentAction.SecondAsset) ? "Asking..." : $"Ask about {DemoAssets.SecondStreetlightAssetId} (new session)")</span>
                                    <svg viewBox="0 0 24 24"><path d="M11 4a7 7 0 1 0 4.9 12.1l4.5 4.5 1.4-1.4-4.5-4.5A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" /></svg>
                                </button>

                                @AgentOutcome(AgentAction.SecondAsset)

                                @if (!string.IsNullOrWhiteSpace(_caseMessage))
                                {
                                    <p class="agent-footnote">@_caseMessage</p>
                                }
                            </div>
                        }

                        @if (IsHostingStage)
                        {
                            <div class="@RailActionClass(DemoStage.Hosting)">
                                @* The beat is this one button pressed in both habitats: LOCAL
                                   answers from the simulated store, FOUNDRY HOSTED from the real
                                   work order in the presenter's own OneDrive through Work IQ. The
                                   switchboard owns the flip. *@
                                <button class="action-button investigate-button @ActionBusyClass(AgentAction.WorkRecords)" @onclick="AskWorkRecordsAsync" disabled="@(_agentBusy || _hostedBusy)">
                                    <span>@(IsRunning(AgentAction.WorkRecords) ? "Asking..." : $"Ask about {DemoAssets.StreetlightAssetId}'s work records")</span>
                                    <svg viewBox="0 0 24 24"><path d="M11 4a7 7 0 1 0 4.9 12.1l4.5 4.5 1.4-1.4-4.5-4.5A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" /></svg>
                                </button>

                                @AgentOutcome(AgentAction.WorkRecords)

                                @if (HostedHabitatSelected && !HostedAgentConfigured)
                                {
                                    <p class="agent-footnote">
                                        Habitat is FOUNDRY HOSTED but no project endpoint is configured.
                                        Set CommandCenterWeb:HostedAgent:ProjectEndpoint (user secrets or an
                                        environment variable) to the Foundry project and restart.
                                    </p>
                                }
                            </div>
                        }
                        </div>

                        @* Cumulative by design: nothing was removed, and the presenter can show
                           that on demand without hunting for this stage's button. *@
                        @if (EarlierActionCount > 0)
                        {
                            <button class="rail-actions-toggle" @onclick="() => _showEarlierActions = !_showEarlierActions">
                                @(_showEarlierActions
                                    ? "Hide earlier stages"
                                    : $"Earlier stages - still available ({EarlierActionCount})")
                            </button>
                        }
                    </section>
                </aside>
            }
        </main>
    }
</div>

@code {
    private CommandCenterSnapshot? _snapshot;
    private string? _message;
    private bool _messageIsError;
    private bool _busy;
    private DateTimeOffset? _lastRefreshed;
    private CancellationTokenSource? _pollingTokenSource;
    private Task? _pollingTask;
    private OperationsAgentResponse? _agentResponse;
    private string? _agentSessionId;
    private string? _lastAgentQuestion;
    private bool _agentBusy;
    private string? _agentMessage;
    private bool _agentMessageIsError;
    private string? _agentEvidenceVersion;
    private bool _agentOwnWriteAdopted;
    private string? _expandedEvidenceId;
    private string? _caseMessage;
    private bool _caseBusy;
    private bool _caseClosed;
    private string? _answerHtmlSource;
    private string _answerHtml = string.Empty;
    private DemoStage? _lastObservedStage;
    private IReadOnlyList<OperationsAgentPendingApproval> _pendingApprovals = [];
    private bool _approvalBusy;
    private bool _workflowBusy;
    private OperationsAgentWorkflowRunReport? _workflowRun;
    private string? _workflowMessage;
    private OperationsAgentWorkflowDefinition? _workflowDefinition;
    private bool _workflowDefinitionLoading;
    private bool _workflowDiagramRendered;
    private string _workflowTab = "diagram";

    private string StageName => _snapshot?.CurrentStage.Name ?? Configuration["DemoStage"] ?? "Deterministic";
    private bool IsAgentStage => _snapshot?.CurrentStage.Id >= DemoStage.InvestigationAgent;
    private bool IsSessionStage => _snapshot?.CurrentStage.Id >= DemoStage.Session;
    private bool IsMemoryStage => _snapshot?.CurrentStage.Id >= DemoStage.Memory;

    // The asset the last question was about, when it named one.
    private string? QuestionedAssetId => ExtractAssetId(_lastAgentQuestion);

    // A case pairs an asset identifier with the symptom observed for it. The identifier comes from
    // the question and the symptom from the displayed snapshot, so the two must be the same asset
    // or the case records something that never happened.
    private bool CaseMatchesDisplayedAsset =>
        _snapshot is { } snapshot
        && string.Equals(QuestionedAssetId ?? snapshot.AssetId, snapshot.AssetId, StringComparison.OrdinalIgnoreCase);
    private bool IsSkillsStage => _snapshot?.CurrentStage.Id >= DemoStage.Skills;
    private bool IsInteractiveStage => _snapshot?.CurrentStage.Id >= DemoStage.InteractiveInput;
    private bool IsWorkflowStage => _snapshot?.CurrentStage.Id >= DemoStage.Workflow;
    private bool IsToolApprovalStage => _snapshot?.CurrentStage.Id >= DemoStage.ToolApproval;
    private string CloseCaseLabel => (_caseBusy, _caseClosed) switch
    {
        (true, _) => "Recording...",
        (false, true) => "Case recorded",
        _ => "Close case (record to memory)"
    };
    private string CloseCaseStateClass => (_caseBusy, _caseClosed) switch
    {
        (true, _) => "busy",
        (false, true) => "action-done",
        _ => string.Empty
    };

    // The answer is model-produced markdown; it is rendered through the sanitizing pipeline once
    // per answer (polling re-renders the component every few seconds, so the result is memoized).
    private string RenderedAnswerHtml
    {
        get
        {
            if (_agentResponse is not { } response)
            {
                return string.Empty;
            }

            if (!ReferenceEquals(_answerHtmlSource, response.Answer))
            {
                _answerHtmlSource = response.Answer;
                _answerHtml = AnswerHtml.ToSafeHtml(response.Answer);
            }

            return _answerHtml;
        }
    }

    // The peer's own reply, rendered the same way and memoized the same way: it is model-produced
    // markdown from another service, and it is untrusted text like any other model output.
    private string RenderedConsultHtml
    {
        get
        {
            if (_agentResponse?.RemoteConsult?.Answer is not { } answer)
            {
                return string.Empty;
            }

            if (!ReferenceEquals(_consultHtmlSource, answer))
            {
                _consultHtmlSource = answer;
                _consultHtml = AnswerHtml.ToSafeHtml(answer);
            }

            return _consultHtml;
        }
    }
    // The outcome of a run - a notice, the hosted answer, or the local answer with its traces -
    // renders under the button that produced it, so "Why?" answers under "Why?" and not under the
    // question box at the top. Every button owns a slot; only the active button's slot renders.
    // Before anything has run, the question box's slot doubles as the panel's notice area.
    private RenderFragment AgentOutcome(AgentAction anchor) => __builder =>
    {
        if ((_activeAction ?? AgentAction.Ask) != anchor)
        {
            return;
        }

        <div class="agent-outcome">
            @* The question box at the top belongs to Ask agent; a rail button's slot states the
               exact question it sent, which its label only abbreviates. *@
            @if (anchor != AgentAction.Ask && _lastAgentQuestion is { } askedQuestion)
            {
                <div class="agent-summary">
                    <small>Operator question</small>
                    <p>@askedQuestion</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_agentMessage))
            {
                <p class="agent-message @(_agentMessageIsError ? "status-error" : string.Empty)">@_agentMessage</p>
            }

            @if (!string.IsNullOrWhiteSpace(_hostedMessage))
            {
                <p class="agent-message status-error">@_hostedMessage</p>
            }

            @* Work IQ's first act for a person is to ask that person. The platform will
               not touch the presenter's Microsoft 365 until they consent, and the
               consent arrives as part of the response - so it renders as the beat it
               is, not as an error. *@
            @if (_hostedConsentLink is { } consentLink)
            {
                <div class="agent-summary">
                    <small>Work IQ consent required</small>
                    <p>
                        Work IQ acts as <em>you</em>, and you have not yet consented. Open the
                        <a href="@consentLink" target="_blank" rel="noopener">Microsoft 365 consent page</a>,
                        sign in as yourself, then ask again.
                    </p>
                </div>
            }

            @if (_hostedAnswerHtml is { } hostedAnswerHtml)
            {
                <div class="agent-summary">
                    <small>Hosted agent answer</small>
                    <div class="agent-answer">@((MarkupString)hostedAnswerHtml)</div>
                </div>

                <p class="agent-footnote">
                    Answered from Foundry's hosted runtime. It read the cloud Energy Hub and, through
                    Work IQ, your own Microsoft 365 - not this laptop's city. The cloud city is not
                    driven by the switchboard: it permanently shows the forgotten-override situation
                    that WO-8732 explains. The platform carried your identity to the agent; a different
                    presenter would get a different answer.
                    @if (_hostedResponseId is { } hostedResponseId)
                    {
                        <text> · Response @ShortCorrelation(hostedResponseId)</text>
                    }
                </p>
            }

            @if (_agentResponse is { } response)
            {
                <div class="agent-summary">
                    <small>Agent answer</small>
                    <div class="agent-answer">@((MarkupString)RenderedAnswerHtml)</div>
                </div>

                @* Outside the capability trace on purpose. The consult is not a tool
                   call and the composing run makes none, so a peer panel nested in the
                   trace would never render for the beat that needs it most. *@
                @if (response.RemoteConsult is { } consult)
                {
                    <div class="agent-summary a2a-panel">
                        <small>Consulted peer (A2A)</small>
                        @if (string.IsNullOrWhiteSpace(consult.Failure))
                        {
                            <p class="a2a-agent">@consult.AgentName</p>
                            <dl class="delegation-fields">
                                <div><dt>Provider</dt><dd>@consult.Provider</dd></div>
                                @* The skill's own description, not only its id. It is
                                   where the peer states what it will not disclose, and
                                   reading that before asking is the whole point of
                                   discovery - so it has to be on screen. *@
                                <div><dt>Advertised skill</dt><dd>@consult.SkillId<span class="a2a-skill-note">@consult.SkillDescription</span></dd></div>
                                <div><dt>Transport</dt><dd>@consult.Transport</dd></div>
                                <div><dt>Task sent</dt><dd>@consult.Question</dd></div>
                            </dl>
                            @* The peer writes markdown too, and it goes through the
                               same sanitizing renderer. Rendering it as plain text put
                               literal asterisks on the projector. *@
                            <div class="a2a-reply agent-answer">@((MarkupString)RenderedConsultHtml)</div>
                            <p class="agent-footnote">
                                Discovered by its agent card, then given a task. The peer read the work order; this agent never did.
                            </p>
                        }
                        else
                        {
                            <p class="a2a-failure">The workforce domain could not be consulted: @consult.Failure</p>
                            <p class="agent-footnote">
                                A peer is another process, so it can be down. The operator is told the specialist did not contribute rather than being handed an answer that quietly lacks it.
                            </p>
                        }
                    </div>
                }

                @if (response.ToolCalls.Count > 0)
                {
                    <div class="agent-summary">
                        <small>
                            Capability trace
                            @if (response.ToolSource == OperationsAgentToolSource.Mcp)
                            {
                                <span class="tool-source-badge">MCP remote</span>
                            }
                        </small>
                        @* A request is not an execution. The model asked for each of
                           these; only some of them ran, and which is the lesson. *@
                        <ol class="trace-calls">
                            @foreach (var call in response.ToolCalls)
                            {
                                <li>
                                    <span class="trace-call">@($"{call.ToolName}({call.Arguments})")</span>
                                    <span class="trace-status @ToolCallStatusClass(call.Status)">@ToolCallStatusLabel(call.Status)</span>
                                </li>
                            }
                        </ol>
                        @if (response.ToolSource == OperationsAgentToolSource.Mcp)
                        {
                            <p class="agent-footnote">The streetlight tool was discovered at runtime from the Energy Hub's MCP server - same capability, new boundary.</p>
                        }
                    </div>

                    @* The delegation is a step of its own: the specialist's identity and
                       its sanitized judgment, not a line of generic tool-result text. *@
                    @foreach (var delegation in response.Delegations ?? [])
                    {
                        <div class="agent-summary delegation-panel">
                            <small>Consulted specialist</small>
                            <p class="delegation-agent">@delegation.AssessedBy</p>
                            @if (delegation.Status == OperationsAgentToolCallStatus.Completed)
                            {
                                <dl class="delegation-fields">
                                    <div><dt>Area</dt><dd>@delegation.Area</dd></div>
                                    <div><dt>Verdict</dt><dd>@(delegation.RequiresLighting ? "Lighting required" : "No lighting requirement")</dd></div>
                                    <div><dt>Classification</dt><dd>@delegation.ReasonCode</dd></div>
                                    <div><dt>Recommendation</dt><dd>@delegation.Recommendation</dd></div>
                                    @if (delegation.UntilUtc is { } until)
                                    {
                                        <div><dt>Until</dt><dd>@until.ToLocalTime().ToString("dd MMM HH:mm") @LocalZoneLabel</dd></div>
                                    }
                                </dl>
                                <p>@delegation.Reason</p>
                                @if (delegation.DetailsWithheld)
                                {
                                    <p class="agent-footnote">Operational detail exists and was deliberately not disclosed: the Operations Agent never sees it.</p>
                                }
                            }
                            else
                            {
                                @* The specialist was asked and nothing came back. The row stays, so an
                                   answer given alone never looks like the consult was switched off. *@
                                <dl class="delegation-fields">
                                    @if (delegation.Area.Length > 0)
                                    {
                                        <div><dt>Area</dt><dd>@delegation.Area</dd></div>
                                    }
                                    <div><dt>Verdict</dt><dd>None - @ToolCallStatusLabel(delegation.Status)</dd></div>
                                </dl>
                                <p>@NoJudgmentExplanation(delegation.Status)</p>
                                <p class="agent-footnote">The answer above was given without the specialist's judgment.</p>
                            }
                        </div>
                    }

                    <p class="agent-footnote">
                        @ToolCallSummary(response) over @(response.ModelRoundTrips) @RoundTripLabel(response) · CorrelationId @ShortCorrelation(response.CorrelationId)
                    </p>
                }
                else
                {
                    <p class="agent-footnote">
                        No tool was invoked (@(response.ModelRoundTrips) @RoundTripLabel(response)) · CorrelationId @ShortCorrelation(response.CorrelationId)
                    </p>
                }

                @if (response.Evidence.Count > 0)
                {
                    <div class="agent-summary">
                        <small>Retrieved evidence</small>
                        <ul class="agent-evidence-list">
                            @foreach (var item in response.Evidence)
                            {
                                <li class="agent-evidence-card">
                                    <button type="button" class="evidence-toggle" @onclick="() => ToggleEvidence(item.Id)">
                                        <span class="evidence-id">@item.Id</span>
                                        <span class="evidence-title">@item.Title</span>
                                        @if (IsCited(response.Answer, item.Id))
                                        {
                                            <span class="evidence-cited">Cited in answer</span>
                                        }
                                    </button>
                                    @if (string.Equals(_expandedEvidenceId, item.Id, StringComparison.Ordinal))
                                    {
                                        <div class="evidence-detail">
                                            <p>@item.Summary</p>
                                            <small>@item.SourceType · recorded @item.OccurredAt.ToLocalTime().ToString("g") · @item.SourceLabel</small>
                                            @if (!string.IsNullOrWhiteSpace(item.SourceUri))
                                            {
                                                <a href="@item.SourceUri" target="_blank" rel="noopener">Open source item</a>
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                        <p class="agent-footnote">
                            What the search returned; the badge marks what the answer cited. Retrieval &ne; citation.
                        </p>
                    </div>
                }
                else if (response.ToolCalls.Any(call => call.ToolName == OperationsAgentToolNames.SearchWorkKnowledge))
                {
                    <div class="agent-summary">
                        <small>Retrieved evidence</small>
                        <p class="agent-empty">The work-knowledge search ran and returned no evidence.</p>
                    </div>
                }

                @if (response.Skills.Count > 0)
                {
                    <div class="agent-summary">
                        <small>Procedure</small>
                        <ul class="agent-evidence-list">
                            @foreach (var skill in response.Skills)
                            {
                                <li class="agent-evidence-card">
                                    <button type="button" class="evidence-toggle" @onclick="() => ToggleEvidence(skill.Name)">
                                        <span class="evidence-id">@skill.Name</span>
                                        <span class="@(skill.Loaded ? "skill-loaded" : "skill-available")">@(skill.Loaded ? "Loaded" : "Available")</span>
                                        @if (string.Equals(_expandedEvidenceId, skill.Name, StringComparison.Ordinal))
                                        {
                                            <span class="evidence-title">@skill.Description</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                        <p class="agent-footnote">
                            Documented procedures the agent discovers and loads on demand. Versioned, expert-authored, auditable.
                        </p>
                    </div>
                }

                @if (response.RecalledCases.Count > 0)
                {
                    <div class="agent-summary">
                        <small>Recalled cases</small>
                        <ul class="agent-evidence-list">
                            @foreach (var recalledCase in response.RecalledCases)
                            {
                                <li class="agent-evidence-card">
                                    <button type="button" class="evidence-toggle" @onclick="() => ToggleEvidence(recalledCase.CaseId)">
                                        <span class="evidence-id">@recalledCase.CaseId</span>
                                        <span class="memory-badge">Hypothesis</span>
                                        <span class="evidence-title">@recalledCase.Symptom (@recalledCase.AssetId)</span>
                                    </button>
                                    @if (string.Equals(_expandedEvidenceId, recalledCase.CaseId, StringComparison.Ordinal))
                                    {
                                        <div class="evidence-detail">
                                            <p>@recalledCase.Resolution</p>
                                            <small>Closed @recalledCase.ClosedAt.ToLocalTime().ToString("g") · agent case memory</small>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                        <p class="agent-footnote">
                            The agent's own past conclusions, recalled as hypotheses. Memory &ne; evidence.
                        </p>
                    </div>
                }
            }
        </div>
    };
    private string AgentStatusText => (_agentBusy || _hostedBusy, _agentResponse is not null || _hostedAnswerHtml is not null) switch
    {
        (true, _) => "Working",
        (false, true) => "Answered",
        _ => "Idle"
    };
