    // A check for a prerequisite the demo already meets, a cross for one it does not, a dot for one
    // that cannot be checked here, and an arrow for a later step's fixture - which is the presenter's
    // own move during the beat, not a precondition of it.
    private (string Mark, string Css) PrerequisiteMark(DemoPrerequisite prerequisite)
    {
        if (!prerequisite.AppliesAtStart)
        {
            return ("→", "wt-later");
        }

        bool? satisfied = prerequisite.Kind switch
        {
            DemoPrerequisiteKind.Scenario => _snapshot?.CurrentScenario.Id == prerequisite.ScenarioId,
            DemoPrerequisiteKind.Switch when prerequisite.Switch is { } @switch
                && _switchValues is not null
                && _switchValues.TryGetValue(@switch, out var value) =>
                string.Equals(value, prerequisite.RequiredValue, StringComparison.OrdinalIgnoreCase),
            _ => null
        };

        return satisfied switch
        {
            true => ("✓", "wt-met"),
            false => ("✗", "wt-unmet"),
            _ => ("·", "wt-unknown")
        };
    }

