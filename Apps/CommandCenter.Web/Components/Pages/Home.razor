    // The Hosting stage's records question, shared by BOTH habitats on purpose: the beat is the
    // same button pressed twice, once answered from the simulated store and once from the real
    // work order in the presenter's OneDrive - the source is the only thing that changed.
    private string WorkRecordsQuestion => WebOptions.Value.HostedAgent.Question;

    // Routed by the switchboard's habitat switch: the same button asks whichever habitat the
    // presenter selected. That routing lives here rather than behind the local agent's API because
    // the hosted call must carry the PRESENTER's identity - the platform reads the caller from the
    // token, and Work IQ answers with what that person can see.
    private async Task AskRoutedAgentAsync(string question, AgentAction action)
    {
        // The switch is re-read at the moment of the ask, not trusted from the poll: a presenter
        // who flips the switchboard and clicks inside the same polling interval must be routed by
        // what they just chose, not by a value up to one tick stale.
        if (IsHostingStage)
        {
            try
            {
                ApplyHabitat((await OperationsAgentClient.GetHabitatAsync(CancellationToken.None)).Habitat);
            }
            catch (Exception)
            {
                // Unreadable at ask time: the last polled value is the best truth available.
            }
        }

        if (HostedHabitatSelected)
        {
            await AskHostedAgentAsync(question, action);
        }
        else
        {
            await AskAgentCoreAsync(question, sessionId: null, action);
        }
    }

    private void ApplyHabitat(OperationsAgentHabitat habitat)
    {
        if (_agentHabitat == habitat)
        {
            return;
        }

        _agentHabitat = habitat;

        // The local conversational session does not follow the agent across habitats: the hosted
        // twin never saw it, and a follow-up button offering to continue it would promise a
        // context the routed agent does not hold.
        if (habitat == OperationsAgentHabitat.FoundryHosted)
        {
            _agentSessionId = null;
        }
    }

    private Task AskWorkRecordsAsync() => AskRoutedAgentAsync(WorkRecordsQuestion, AgentAction.WorkRecords);

    private async Task AskHostedAgentAsync(string question, AgentAction action)
    {
        if (_hostedBusy || _agentBusy)
        {
            return;
        }

        _activeAction = action;
        _hostedBusy = true;
        _hostedMessage = null;
        _hostedAnswerHtml = null;
        _hostedConsentLink = null;
        _hostedResponseId = null;
        // One panel, one answer: a hosted answer replaces the local one on screen, exactly as a
        // local answer clears the hosted one - showing both would invite reading them as one run.
        _agentResponse = null;
        _agentMessage = null;
        _agentMessageIsError = false;
        _lastAgentQuestion = question;

        try
        {
            var outcome = await HostedAgentClient.AskAsync(question, CancellationToken.None);
            _hostedResponseId = outcome.ResponseId;

            if (outcome is { Succeeded: true, Answer: { } answer })
            {
                _hostedAnswerHtml = AnswerHtml.ToSafeHtml(answer);
            }
            else if (outcome.ConsentLink is { } consentLink)
            {
                _hostedConsentLink = consentLink;
            }
            else
            {
                _hostedMessage = outcome.FailureMessage;
            }
        }
        catch (Exception exception)
        {
            _hostedMessage = $"The hosted agent could not be reached: {exception.Message}";
        }
        finally
        {
            _hostedBusy = false;
        }
    }
