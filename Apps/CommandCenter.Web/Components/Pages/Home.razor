    // The workflow definition (diagram + YAML) loads lazily the first time it is actually relevant,
    // and the Mermaid diagram renders once its container exists in the DOM. Loading it while the
    // panel is not shown would also render the diagram into a container with no layout.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (WorkflowDefinitionIsRelevant && _workflowDefinition is null && !_workflowDefinitionLoading)
        {
            _workflowDefinitionLoading = true;

            try
            {
                _workflowDefinition = await OperationsAgentClient.GetWorkflowDefinitionAsync(CancellationToken.None);
                StateHasChanged();
            }
            catch (Exception exception)
            {
                _workflowMessage = $"The workflow definition could not be loaded: {exception.Message}";
            }
            finally
            {
                _workflowDefinitionLoading = false;
            }
        }

        // Leaving the Workflow stage removes the diagram element from the DOM, so the next visit
        // must render into the new element rather than trusting a flag from the old one.
        if (!IsWorkflowStage)
        {
            _workflowDiagramRendered = false;
            return;
        }

        if (_workflowDefinition is { } definition && !_workflowDiagramRendered)
        {
            try
            {
                await JS.InvokeVoidAsync("caesareaWorkflow.render", "workflow-diagram", definition.Mermaid);
                // Only a render that actually succeeded counts; a failed interop call must leave
                // the next pass free to try again.
                _workflowDiagramRendered = true;
            }
            catch (JSException exception)
            {
                _workflowMessage = $"The workflow diagram could not be rendered: {exception.Message}";
                return;
            }

            // A run may already be on screen after a reconnect or a late-arriving definition,
            // so project its state onto the freshly rendered diagram.
            await ApplyDiagramHighlightAsync();
        }
    }

    private void SelectWorkflowTab(string tab) => _workflowTab = tab;

    // Read from the request itself, never inferred from what this page happens to be doing: an
    // agent-started workflow and a concurrent ask would both fool a busy-flag guess.
    private static string ApprovalFootnote(OperationsAgentPendingApproval approval) => approval.ControlPoint switch
    {
        OperationsAgentControlPoint.WorkflowGate =>
            "The workflow's approval node is paused. Nothing changes until you answer.",
        OperationsAgentControlPoint.ToolApproval =>
            "The agent selected a protected capability and the framework intercepted the call. Nothing runs until you answer.",
        _ => "The remote tool is paused input-required (MCP MRTR). Nothing changes until you answer."
    };

    private static string WorkflowOutcomeClass(OperationsAgentWorkflowRunReport run) => run.Status switch
    {
        "Succeeded" => "resolved",
        "Failed" => "failed",
        _ => "unresolved"
    };

    // Projects the live run onto the generated diagram - completed nodes turn green, the active
    // node pulses amber, and a failed node turns red. Without a run, every mark is removed.
    private async Task ApplyDiagramHighlightAsync()
    {
        if (!_workflowDiagramRendered)
        {
            return;
        }

        var states = new Dictionary<string, string>(StringComparer.Ordinal);

        if (_workflowRun is { } run)
        {
            foreach (var step in run.Steps)
            {
                states[step.ExecutorId] = step.Status.ToLowerInvariant();
            }
        }

        try
        {
            await JS.InvokeVoidAsync("caesareaWorkflow.highlight", "workflow-diagram", states);
        }
        catch (JSException)
        {
            // Highlighting is a visual garnish; a failed interop call must not break the run view.
        }
    }

    private async Task RunWorkflowAsync()
    {
        if (_workflowBusy)
        {
            return;
        }

        _workflowBusy = true;
        _workflowMessage = null;
        _workflowRun = null;
        using var approvalPolling = new CancellationTokenSource();
        var approvalPollingTask = PollApprovalsAsync(approvalPolling.Token);

        try
        {
            var report = await OperationsAgentClient.StartWorkflowRunAsync(
                _snapshot?.AssetId ?? WebOptions.Value.AssetId, CancellationToken.None);
            await MonitorWorkflowRunAsync(report);
            await LoadSnapshotAsync(CancellationToken.None, showErrorIfMissing: false);
        }
        catch (Exception exception)
        {
            _workflowMessage = $"The workflow could not be run: {exception.Message}";
        }
        finally
        {
            _workflowBusy = false;
            await approvalPolling.CancelAsync();
            await approvalPollingTask;
            _pendingApprovals = [];
        }
    }

    // Follows one run to its end, whoever started it: the panel button, or the agent on the
    // operator's behalf. The caller owns approval polling, so the gate stays answerable.
    private async Task MonitorWorkflowRunAsync(OperationsAgentWorkflowRunReport report)
    {
        _workflowRun = report;
        StateHasChanged();
        await ApplyDiagramHighlightAsync();

        // The server bounds a run at five minutes; this polling cap is just above it.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var remainingTicks = 360;

        while (_workflowRun is { Completed: false } && remainingTicks-- > 0 && await timer.WaitForNextTickAsync())
        {
            try
            {
                _workflowRun = await OperationsAgentClient.GetWorkflowRunAsync(report.RunId, CancellationToken.None);
            }
            catch (Exception)
            {
                // One failed poll must not end the timeline; the next tick tries again.
            }

            StateHasChanged();
            await ApplyDiagramHighlightAsync();
        }
    }

    // At the Workflow stage the agent answers by *starting* an operation, so the answer arrives
    // long before the run does. Adopt the run it started - found by this request's correlation -
    // so its steps appear and its approval gate is answerable from the same panel.
    private async Task AdoptAgentStartedRunAsync(string? correlationId)
    {
        if (!IsWorkflowStage || string.IsNullOrWhiteSpace(correlationId))
        {
            return;
        }

        try
        {
            // The tool returns as soon as the run is registered, but validation may still be in
            // flight; a few attempts cover the gap without blocking the answer.
            for (var attempt = 0; attempt < 5; attempt++)
            {
                if (await OperationsAgentClient.FindWorkflowRunByCorrelationAsync(correlationId, CancellationToken.None) is { } report)
                {
                    using var approvalPolling = new CancellationTokenSource();
                    var approvalPollingTask = PollApprovalsAsync(approvalPolling.Token);

                    try
                    {
                        await MonitorWorkflowRunAsync(report);
                    }
                    finally
                    {
                        await approvalPolling.CancelAsync();
                        await approvalPollingTask;
                        _pendingApprovals = [];
                    }

                    await LoadSnapshotAsync(CancellationToken.None, showErrorIfMissing: false);
                    return;
                }

                await Task.Delay(TimeSpan.FromMilliseconds(400));
            }
        }
        catch (Exception exception)
        {
            _workflowMessage = $"The workflow the agent started could not be followed: {exception.Message}";
        }
    }

    private async Task RespondToApprovalAsync(string approvalId, bool approved)
    {
        if (_approvalBusy)
        {
            return;
        }

        _approvalBusy = true;

        try
        {
            await OperationsAgentClient.RespondToApprovalAsync(approvalId, approved, CancellationToken.None);
            _pendingApprovals = [.. _pendingApprovals.Where(approval => approval.Id != approvalId)];
        }
        catch (Exception exception)
        {
            // The prompt stays: the tool call is still paused, and the operator can answer again.
            _agentMessage = $"The answer could not be delivered: {exception.Message} The request is still pending.";
            _agentMessageIsError = true;
        }
        finally
        {
            _approvalBusy = false;
        }
    }

    // While an agent run is in flight, a paused MCP tool may be waiting for the operator; poll the
    // pending-approvals endpoint so the prompt appears without a page action.
    private async Task PollApprovalsAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1.5));

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                IReadOnlyList<OperationsAgentPendingApproval> approvals;

                try
                {
                    approvals = await OperationsAgentClient.GetPendingApprovalsAsync(cancellationToken);
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    return;
                }
                catch (Exception)
                {
                    // One failed poll must not silence the operator prompt for the rest of the
                    // run; the next tick tries again.
                    continue;
                }

                await InvokeAsync(() =>
                {
                    _pendingApprovals = approvals;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // The agent run finished; the prompt panel is cleared below.
        }
    }

    private async Task CloseCaseAsync()
    {
        // Guarded here as well as in the markup: the symptom below is derived from this snapshot,
        // so an asset mismatch would record one asset's identifier against another's state.
        if (_caseBusy || _caseClosed || _agentResponse is not { } response || _snapshot is not { } snapshot
            || !CaseMatchesDisplayedAsset)
        {
            return;
        }

        _caseBusy = true;

        try
        {
            var assetId = ExtractAssetId(_lastAgentQuestion) ?? snapshot.AssetId;
            // The answer is markdown; a stored case is recalled into a plain-text view, so the
            // markup is removed before the length limit is applied to what actually gets stored.
            var plainAnswer = AnswerHtml.ToPlainText(response.Answer);
            var resolution = plainAnswer.Length <= 500 ? plainAnswer : $"{plainAnswer[..500]}…";
            var closedCase = await OperationsAgentClient.CloseCaseAsync(
                assetId,
                CaseSymptom.Describe(assetId, snapshot.OperationalState),
                resolution,
                CancellationToken.None);
            _caseMessage = $"Case {closedCase.CaseId} recorded to the agent's memory for {closedCase.AssetId}.";
            _caseClosed = true;
        }
        catch (Exception exception)
        {
            _caseMessage = $"The case could not be recorded: {exception.Message}";
        }
        finally
        {
            _caseBusy = false;
        }
    }

    private static string? ExtractAssetId(string? question)
    {
        if (string.IsNullOrWhiteSpace(question))
        {
            return null;
        }

        var match = System.Text.RegularExpressions.Regex.Match(
            question,
            @"\bL-\d{3}\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase,
            TimeSpan.FromSeconds(1));
        return match.Success ? match.Value.ToUpperInvariant() : null;
    }

    private Task AskAgentCoreAsync(string question, string? sessionId, AgentAction action) =>
        AskAgentCoreAsync(
            question,
            token => OperationsAgentClient.AskAsync(question, sessionId, token),
            tracksEvidence: true,
            action);

    // An answer about the city is only true of the city it was asked about, so it is pinned to the
    // evidence version it was produced against. A delegated consult is not: the peer answers about
    // a work order, and a lamp that switches underneath the consult says nothing about whether that
    // answer is still right. Versioning it would throw away a good answer mid-beat.
    private async Task AskAgentCoreAsync(
        string question,
        Func<CancellationToken, Task<OperationsAgentOutcome>> call,
        bool tracksEvidence,
        AgentAction action)
    {
        var requestedEvidenceVersion = AgentEvidenceGuard.GetEvidenceVersion(_snapshot);
        _agentAnswerTracksEvidence = tracksEvidence;
        _activeAction = action;
        _agentBusy = true;
        _agentResponse = null;
        _agentEvidenceVersion = null;
        _agentOwnWriteAdopted = false;
        _expandedEvidenceId = null;
        _caseMessage = null;
        _caseClosed = false;
        _agentMessage = null;
        _agentMessageIsError = false;
        _lastAgentQuestion = question;
        _hostedAnswerHtml = null;
        _hostedMessage = null;
        _hostedConsentLink = null;
        using var approvalPolling = new CancellationTokenSource();
        var approvalPollingTask = PollApprovalsAsync(approvalPolling.Token);

        try
        {
            var outcome = await call(CancellationToken.None);

            if (outcome.Succeeded)
            {
                // The run may have just executed an approved write; judge the answer against a
                // fresh snapshot, where the agent's own restore counts as current, not stale.
                await LoadSnapshotAsync(CancellationToken.None, showErrorIfMissing: false);

                var stillCurrent = AgentEvidenceGuard.IsAnswerCurrent(
                    requestedEvidenceVersion,
                    _snapshot,
                    outcome.Result?.CorrelationId,
                    ownWriteAlreadyAdopted: false,
                    out var currentEvidenceVersion,
                    out var adoptedOwnWrite);

                if (!tracksEvidence || stillCurrent)
                {
                    _agentResponse = outcome.Result;
                    // A run that opened no conversational session reports an empty one. Adopting
                    // that would light up the follow-up button with nothing behind it, and the
                    // "same session" it promises would not exist.
                    _agentSessionId = string.IsNullOrEmpty(outcome.Result?.SessionId)
                        ? _agentSessionId
                        : outcome.Result.SessionId;
                    _agentEvidenceVersion = currentEvidenceVersion;
                    _agentOwnWriteAdopted = adoptedOwnWrite;
                }
                else
                {
                    _agentMessage = $"{StaleAnswerCause(requestedEvidenceVersion, currentEvidenceVersion)} while the agent was answering. Ask again.";
                    _agentMessageIsError = true;
                }
            }
            else
            {
                _agentResponse = null;
                _agentMessage = outcome.FailureMessage;
                _agentMessageIsError = true;
            }
        }
        catch (Exception exception)
        {
            _agentResponse = null;
            _agentMessage = $"The Operations Agent could not answer: {exception.Message}";
            _agentMessageIsError = true;
        }
        finally
        {
            _agentBusy = false;
            await approvalPolling.CancelAsync();
            await approvalPollingTask;
            _pendingApprovals = [];
        }

        // The agent may have answered by starting a governed operation rather than acting; follow
        // it so the operator sees - and can answer - the run the agent started for them.
        if (_agentResponse is { } startedResponse)
        {
            await AdoptAgentStartedRunAsync(startedResponse.CorrelationId);
        }
    }

    private async Task LoadSnapshotAsync(CancellationToken cancellationToken, bool showErrorIfMissing)
    {
        try
        {
            var snapshot = await ApiClient.GetSnapshotAsync(cancellationToken);
            _snapshot = snapshot;
            _lastRefreshed = DateTimeOffset.Now;

            if (_showWalkthrough)
            {
                await LoadSwitchValuesAsync(cancellationToken);
            }

            // A stage downgrade invalidates the conversational session: its history may carry
            // capabilities (loaded skills, retrieved evidence) the earlier stage must not expose.
            if (_lastObservedStage is { } previousStage && snapshot.CurrentStage.Id < previousStage && _agentSessionId is not null)
            {
                _agentSessionId = null;
                _agentMessage = "Demo stage moved back; the conversational session was reset.";
                _agentMessageIsError = false;
            }

            if (snapshot.CurrentStage.Id < DemoStage.Workflow && _workflowRun is not null)
            {
                _workflowRun = null;
                _workflowMessage = null;
            }

            // Every stage change starts a new beat, so the rail folds back to that stage's action
            // rather than staying open from the last time the presenter looked at the history.
            if (_lastObservedStage != snapshot.CurrentStage.Id)
            {
                _showEarlierActions = false;
            }

            _lastObservedStage = snapshot.CurrentStage.Id;

            // The habitat switch lives on the agent service and is flipped from the switchboard, so
            // it rides the same poll that carries the stage. Its failure is kept apart from the
            // snapshot's: a habitat read that fails leaves the last known selection standing rather
            // than blanking the city view.
            if (snapshot.CurrentStage.Id >= DemoStage.Hosting)
            {
                try
                {
                    ApplyHabitat((await OperationsAgentClient.GetHabitatAsync(cancellationToken)).Habitat);
                }
                catch (Exception)
                {
                    // One failed read keeps the last known selection; the next tick tries again.
                }
            }
            else if (_agentHabitat != OperationsAgentHabitat.Local)
            {
                // Below the Hosting stage the service resets the switch itself; mirroring that here
                // keeps the badge honest even before the next successful habitat read.
                ApplyHabitat(OperationsAgentHabitat.Local);
            }

            if (_agentAnswerTracksEvidence && _agentResponse is { } agentResponse)
            {
                if (AgentEvidenceGuard.IsAnswerCurrent(
                    _agentEvidenceVersion,
                    snapshot,
                    agentResponse.CorrelationId,
                    _agentOwnWriteAdopted,
                    out var currentEvidenceVersion,
                    out var adoptedOwnWrite))
                {
                    // An own write that propagated after the answer landed advances the guard's
                    // floor once; anything after that makes the answer stale.
                    _agentEvidenceVersion = currentEvidenceVersion;
                    _agentOwnWriteAdopted |= adoptedOwnWrite;
                }
                else
                {
                    var cause = StaleAnswerCause(_agentEvidenceVersion, currentEvidenceVersion);
                    _agentResponse = null;
                    _agentEvidenceVersion = null;
                    _agentOwnWriteAdopted = false;
                    _agentMessage = $"{cause}. Ask the agent again.";
                    _agentMessageIsError = false;
                }
            }

            if (!_messageIsError)
            {
                _message = null;
            }
        }
        catch (Exception exception)
        {
            if (showErrorIfMissing || _snapshot is null)
            {
                _message = $"Unable to load the authoritative snapshot: {exception.Message}";
                _messageIsError = true;
            }
        }
    }

    private static string OnOff(bool value) => value ? "On" : "Off";

    private static string YesNo(bool value) => value ? "Yes" : "No";

    private static string FormatTimestamp(DateTimeOffset? value) =>
        value?.ToLocalTime().ToString("HH:mm:ss") ?? "n/a";

    private static string ToolCallStatusLabel(OperationsAgentToolCallStatus status) => status switch
    {
        OperationsAgentToolCallStatus.Completed => "ran",
        OperationsAgentToolCallStatus.Denied => "denied - did not run",
        OperationsAgentToolCallStatus.Failed => "failed",
        _ => "requested - not run"
    };

    private static string ToolCallStatusClass(OperationsAgentToolCallStatus status) => status switch
    {
        OperationsAgentToolCallStatus.Completed => "ran",
        OperationsAgentToolCallStatus.Denied => "denied",
        OperationsAgentToolCallStatus.Failed => "failed",
        _ => "requested"
    };

    private static string NoJudgmentExplanation(OperationsAgentToolCallStatus status) => status switch
    {
        OperationsAgentToolCallStatus.Failed => "The specialist was consulted but did not answer - the call failed, so no judgment crossed the boundary. A Security Agent parked at a breakpoint looks exactly like this.",
        OperationsAgentToolCallStatus.Denied => "The consultation was declined, so the specialist was never asked.",
        _ => "The consultation was requested but never finished."
    };

    // Counting requests as invocations is exactly the claim this stage disproves, so the summary
    // counts what ran and names the rest separately.
    // This service counts its own round trips and nothing else. When a peer contributed, the number
    // covers only the composing run here - the peer's own investigation ran in another process and
    // is not observable from this side, so calling it "model round trips" would overclaim.
    private static string RoundTripLabel(OperationsAgentResponse response) =>
        response.RemoteConsult is null ? "model round trip(s)" : "local composer round trip(s)";

    private static string ToolCallSummary(OperationsAgentResponse response)
    {
        var ran = response.ToolCalls.Count(call => call.Status == OperationsAgentToolCallStatus.Completed);
        var notRun = response.ToolCalls.Count - ran;

        return notRun == 0
            ? $"{ran} tool call(s) ran"
            : $"{ran} of {response.ToolCalls.Count} tool call(s) ran; {notRun} requested but not executed";
    }

    // An answer goes stale for several different reasons, and the operator is told which one.
    // Reporting a stage advance as an operational change sends the presenter looking at the city
    // for something that never happened.
    private static string StaleAnswerCause(string? requestedEvidenceVersion, string? currentEvidenceVersion) =>
        AgentEvidenceGuard.DescribeChange(requestedEvidenceVersion, currentEvidenceVersion) switch
        {
            AgentEvidenceChange.Stage => "The demo stage changed",
            AgentEvidenceChange.Scenario => "A different scenario was applied",
            AgentEvidenceChange.CustomerReport => "The customer report changed",
            AgentEvidenceChange.Incident => "The incident record changed",
            _ => "Operational state changed"
        };

    // Every clock on this dashboard is local; the offset is stated once, in the header.
    private static string LocalZoneLabel
    {
        get
        {
            var offset = DateTimeOffset.Now.Offset;
            var sign = offset < TimeSpan.Zero ? "-" : "+";
            var minutes = Math.Abs(offset.Minutes);

            return minutes == 0
                ? $"UTC{sign}{Math.Abs(offset.Hours)}"
                : $"UTC{sign}{Math.Abs(offset.Hours)}:{minutes:00}";
        }
    }

    private static string ShortCorrelation(string value) =>
        value.Length <= 12 ? value : value[..12];

    private void ToggleEvidence(string evidenceId) =>
        _expandedEvidenceId = string.Equals(_expandedEvidenceId, evidenceId, StringComparison.Ordinal)
            ? null
            : evidenceId;

    // Exact containment of an identifier we own - deliberately not prose parsing. The agent's
    // instructions require citing the identifiers it used, so this marks retrieved-and-cited
    // evidence apart from retrieved-but-discarded evidence.
    private static bool IsCited(string answer, string evidenceId) =>
        answer.Contains(evidenceId, StringComparison.OrdinalIgnoreCase);

    public async ValueTask DisposeAsync()
    {
        if (_pollingTokenSource is null)
        {
            return;
        }

        await _pollingTokenSource.CancelAsync();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
                // Normal shutdown path: the polling task ends by cancellation during dispose.
            }
        }

        _pollingTokenSource.Dispose();
    }
}
