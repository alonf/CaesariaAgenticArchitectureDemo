@page "/"
@implements IAsyncDisposable
@inject DemoScenarioApiClient ApiClient
@inject DemoStageApiClient StageClient
@inject DemoBreakpointsApiClient BreakpointsClient
@inject WorkKnowledgeApiClient WorkKnowledgeClient
@inject CaseMemoryApiClient CaseMemoryClient
@inject ToolSourceApiClient ToolSourceClient
@inject AgentHabitatApiClient AgentHabitatClient
@inject SecurityConsultApiClient SecurityConsultClient
@inject WorkforceRecordsApiClient WorkforceRecordsClient
@inject VsCodeAttachService AttachService
@inject IConfiguration Configuration
@inject IOptions<DemoControlWebOptions> WebOptions

<PageTitle>Caesarea Demo Control</PageTitle>

<div class="page-shell">
    <header class="hero">
        <div>
            <p class="eyebrow">Presenter Only</p>
            <h1>Deterministic Scenario Control</h1>
            <p class="subtitle">Use the five curated deterministic scenarios to drive the Energy and Command Center vertical slice. Stage: @StageName.</p>
        </div>
        <div class="hero-actions">
            <button class="button secondary" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
            <button class="button primary" @onclick="ResetAsync" disabled="@_busy">Reset to Normal Operation</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <section class="message-banner @(_messageIsError ? "error" : "success")">
            <strong>@(_messageIsError ? "Attention:" : "Update:")</strong>
            <span>@_message</span>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_stageMessage))
    {
        <section class="message-banner @(_stageMessageIsError ? "error" : "success")">
            <strong>@(_stageMessageIsError ? "Attention:" : "Update:")</strong>
            <span>@_stageMessage</span>
        </section>
    }

    @* The scenarios lead: a presenter applies one every beat, and it must not sit below the
       switches. The active card carries the outcome of the last application, so there is no
       separate "current scenario" panel repeating the same name and description. *@
    @if (_catalog is null)
    {
        <section class="panel empty-state">
            <p>Loading scenario catalog...</p>
        </section>
    }
    else
    {
        <section class="scenario-grid" aria-label="Scenarios">
            @foreach (var (scenario, index) in _catalog.Scenarios.Select((item, position) => (item, position)))
            {
                var isCurrent = scenario.Id == _catalog.CurrentScenario.Id;
                <article class="panel scenario-card @(isCurrent ? "active" : string.Empty)">
                    <span class="card-tag">Scenario @(index + 1)</span>
                    <h2>@scenario.Name</h2>
                    <p>@scenario.Description</p>
                    @if (isCurrent)
                    {
                        <p class="scenario-status @(string.IsNullOrWhiteSpace(_catalog.CurrentScenario.FailureSummary) ? string.Empty : "status-error")">
                            @_catalog.CurrentScenario.ApplicationStatus · @_catalog.CurrentScenario.AppliedAt.ToLocalTime().ToString("HH:mm:ss")
                            @if (!string.IsNullOrWhiteSpace(_catalog.CurrentScenario.FailureSummary))
                            {
                                <text> · @_catalog.CurrentScenario.FailureSummary</text>
                            }
                        </p>
                    }
                    <button class="button @(isCurrent ? "primary" : "secondary")" @onclick="() => ApplyScenarioAsync(scenario.Id)" disabled="@_busy">
                        @(isCurrent ? "Apply again" : "Apply Scenario")
                    </button>
                </article>
            }
        </section>
    }

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Presenter Switchboard</h2>
            <span class="stamp">@(_stageCatalog is null ? "Loading..." : _stageCatalog.CurrentStage.AppliedAt.ToLocalTime().ToString("HH:mm:ss"))</span>
        </div>
        @if (_stageCatalog is null)
        {
            <p>Loading demo stage catalog...</p>
        }
        else
        {
            <p class="panel-intro">
                Current stage: <strong>@_stageCatalog.CurrentStage.Name</strong> - @_stageCatalog.CurrentStage.Description
            </p>
            <ul class="capability-chips">
                @foreach (var capability in _stageCatalog.CurrentStage.Capabilities)
                {
                    <li>@capability</li>
                }
            </ul>
            <div class="stage-switch-actions">
                @foreach (var stage in _stageCatalog.Stages)
                {
                    <button
                        class="button @(stage.Id == _stageCatalog.CurrentStage.Id ? "primary" : "secondary")"
                        @onclick="() => ApplyStageAsync(stage.Id)"
                        disabled="@_stageBusy">
                        @stage.Name
                    </button>
                }
            </div>
            <p class="switchboard-note">Resetting to Normal Operation preserves the currently selected stage.</p>
        }
    </section>

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Demo Breakpoints</h2>
            <span class="stamp">@BreakpointStamp</span>
        </div>
        @if (_breakpoints is null)
        {
            <p>@(_breakpointsMessage ?? "Loading demo breakpoints...")</p>
        }
        else
        {
            <p class="panel-intro">Arm a snippet to pause its service at that code on its next run, then single-step it in the editor. A snippet lives in the service whose code it pauses, so each service is attached separately.</p>

            @if (_attachStatus is { VsCodeAvailable: true, ExtensionInstalled: false })
            {
                <div class="stage-switch-actions">
                    <button class="button primary" @onclick="InstallExtensionAsync" disabled="@_attachBusy">
                        @(_attachBusy ? "Installing..." : "Install VS Code extension")
                    </button>
                </div>
            }

            @foreach (var source in _breakpoints)
            {
                <div class="breakpoint-source">
                    <div class="breakpoint-source-heading">
                        <strong>@source.Service.DisplayName</strong>
                        <span class="stamp">@SourceStamp(source)</span>
                    </div>

                    @if (source.Error is not null)
                    {
                        <p class="switchboard-note status-error">@source.Error</p>
                    }
                    else
                    {
                        <ul class="checkbox-list">
                            @foreach (var snippet in source.Snippets)
                            {
                                <li>
                                    <label>
                                        <input
                                            type="checkbox"
                                            checked="@snippet.IsArmed"
                                            disabled="@ArmDisabled"
                                            @onchange="e => SetBreakpointAsync(source.Service.ClientName, snippet.SnippetName, e.Value is true)" />
                                        @snippet.SnippetName - break on next run
                                    </label>
                                </li>
                            }
                        </ul>

                        @if (_attachStatus is { ExtensionInstalled: true } && !source.DebuggerAttached)
                        {
                            <div class="stage-switch-actions">
                                <button class="button secondary" @onclick="() => RequestAttachAsync(source.Service.ProcessName)" disabled="@_attachBusy">
                                    @(_attachBusy ? "Requesting..." : $"Attach debugger to {source.Service.DisplayName}")
                                </button>
                            </div>
                        }
                    }
                </div>
            }

            @if (_attachStatus is { VsCodeAvailable: false })
            {
                <p class="switchboard-note">The VS Code CLI was not found on this machine; breakpoint arming is unavailable.</p>
            }
            else if (_attachStatus is { ExtensionInstalled: false })
            {
                <p class="switchboard-note">Breakpoint arming is disabled until the demo-attach VS Code extension is installed.</p>
            }
            else
            {
                <p class="switchboard-note">Armed snippets stay armed until a debugged run consumes them.</p>
            }
        }
        @if (!string.IsNullOrWhiteSpace(_attachMessage))
        {
            <p class="@(_attachMessageIsError ? "status-error" : string.Empty)">@_attachMessage</p>
        }
    </section>

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Work Knowledge</h2>
            <span class="stamp">@WorkKnowledgeStamp</span>
        </div>
        @if (_workKnowledge is null)
        {
            <p>@(_workKnowledgeMessage ?? "Loading work knowledge state...")</p>
        }
        else
        {
            <label>
                <input
                    type="checkbox"
                    checked="@_workKnowledge.EvidencePresent"
                    disabled="@_workKnowledgeBusy"
                    @onchange="e => SetWorkEvidenceAsync(e.Value is true)" />
                Seeded evidence (WO-8732 and the technician note) is available to the agent
            </label>
            <p class="switchboard-note">Uncheck to show the agent reporting missing evidence instead of inventing a work order.</p>
            @if (!string.IsNullOrWhiteSpace(_workKnowledgeMessage))
            {
                <p class="status-error">@_workKnowledgeMessage</p>
            }
        }
    </section>

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Case Memory</h2>
            <span class="stamp">@CaseMemoryStamp</span>
        </div>
        @if (_caseMemory is null)
        {
            <p>@(_caseMemoryMessage ?? "Loading case memory...")</p>
        }
        else
        {
            @if (_caseMemory.Cases.Count == 0)
            {
                <p class="switchboard-note">No closed cases yet. Close a case from the Command Center at the Memory stage.</p>
            }
            else
            {
                <ul class="switchboard-note">
                    @foreach (var closedCase in _caseMemory.Cases)
                    {
                        <li>@closedCase.CaseId (@closedCase.AssetId) - @closedCase.Symptom</li>
                    }
                </ul>
            }
            <button class="button secondary" @onclick="ClearCaseMemoryAsync" disabled="@(_caseMemoryBusy || _caseMemory.Cases.Count == 0)">
                Clear case memory
            </button>
            @if (!string.IsNullOrWhiteSpace(_caseMemoryMessage))
            {
                <p class="status-error">@_caseMemoryMessage</p>
            }
        }
    </section>

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Tool Source</h2>
            <span class="stamp">@ToolSourceStamp</span>
        </div>
        @if (_toolSource is null)
        {
            <p>@(_toolSourceMessage ?? "Loading tool source...")</p>
        }
        else
        {
            <p class="panel-intro">Where the agent's streetlight tool comes from. The flip is the lecture beat: same capability, new boundary.</p>
            <div class="stage-switch-actions">
                <button class="button @(_toolSource.Source == "Local" ? "primary" : "secondary")" @onclick='() => SetToolSourceAsync("Local")' disabled="@_toolSourceBusy">
                    LOCAL function
                </button>
                <button class="button @(_toolSource.Source == "Mcp" ? "primary" : "secondary")" @onclick='() => SetToolSourceAsync("Mcp")' disabled="@_toolSourceBusy">
                    MCP remote
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_toolSourceMessage))
            {
                <p class="status-error">@_toolSourceMessage</p>
            }
        }
    </section>

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Agent Habitat</h2>
            <span class="stamp">@AgentHabitatStamp</span>
        </div>
        @if (_agentHabitat is null)
        {
            <p>@(_agentHabitatMessage ?? "Loading agent habitat...")</p>
        }
        else
        {
            <p class="panel-intro">
                Which habitat answers the Command Center's questions. FOUNDRY HOSTED is the same agent
                code on Microsoft Foundry's runtime: it reads the CLOUD Energy Hub and reaches the work
                order in the presenter's own OneDrive through Work IQ, asking as the signed-in person.
                The cloud city is NOT controlled from this switchboard - its demo surface is
                deliberately off, and it permanently shows the forgotten-override situation that work
                order WO-8732 explains. First hosted use per person shows a consent link in the
                Command Center - open it, consent, ask again. Requires the Hosting stage.
            </p>
            <div class="stage-switch-actions">
                <button class="button @(_agentHabitat.Habitat == "Local" ? "primary" : "secondary")" @onclick='() => SetAgentHabitatAsync("Local")' disabled="@_agentHabitatBusy">
                    LOCAL (Aspire)
                </button>
                <button class="button @(_agentHabitat.Habitat == "FoundryHosted" ? "primary" : "secondary")" @onclick='() => SetAgentHabitatAsync("FoundryHosted")' disabled="@_agentHabitatBusy">
                    FOUNDRY HOSTED
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_agentHabitatMessage))
            {
                <p class="status-error">@_agentHabitatMessage</p>
            }
        }
    </section>

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Security Consult</h2>
            <span class="stamp">@SecurityConsultStamp</span>
        </div>
        @if (_securityConsult is null)
        {
            <p>@(_securityConsultMessage ?? "Loading security consult...")</p>
        }
        else
        {
            <p class="panel-intro">Whether the Operations Agent may consult the Security Operations Agent. Ask the same question with it off and on: with it off the lamp is still intentional, but the reason belongs to a domain that will not disclose it.</p>
            <div class="stage-switch-actions">
                <button class="button @(_securityConsult.Enabled ? "secondary" : "primary")" @onclick="() => SetSecurityConsultAsync(false)" disabled="@_securityConsultBusy">
                    Consult OFF
                </button>
                <button class="button @(_securityConsult.Enabled ? "primary" : "secondary")" @onclick="() => SetSecurityConsultAsync(true)" disabled="@_securityConsultBusy">
                    Consult ON
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_securityConsultMessage))
            {
                <p class="status-error">@_securityConsultMessage</p>
            }
        }
    </section>

    @* The A2A beat's closing move. The peer answered from a projection; this is the record that
       projection came out of, so the presenter can point at the fields that never left the domain.
       Hidden until asked for - these are on the projector for one minute of a ninety-minute talk. *@
    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Workforce Records</h2>
            <span class="stamp">@WorkforceRecordsStamp</span>
        </div>
        <p class="panel-intro">The work orders as the workforce domain holds them, read straight from the Workforce Hub. The peer agent never received these fields: its tool returns a projection that does not select them.</p>
        <div class="stage-switch-actions">
            <button class="button @(_workforceRecords is null ? "primary" : "secondary")" @onclick="ToggleWorkforceRecordsAsync" disabled="@_workforceRecordsBusy">
                @WorkforceRecordsButtonLabel
            </button>
        </div>
        @if (_workforceRecords is { } records)
        {
            @foreach (var record in records)
            {
                <div class="wf-record">
                    <p class="wf-record-head">@record.WorkOrderId - @record.Title (@record.Status)</p>
                    <dl class="wf-record-fields">
                        <div class="wf-shared"><dt>Reason</dt><dd>@record.Reason</dd></div>
                        <div class="wf-shared"><dt>Operational summary</dt><dd>@record.OperationalSummary</dd></div>
                        <div class="wf-withheld"><dt>Technician</dt><dd>@record.TechnicianName</dd></div>
                        <div class="wf-withheld"><dt>Badge</dt><dd>@record.TechnicianBadge</dd></div>
                        <div class="wf-withheld"><dt>Labour cost</dt><dd>@record.LabourCost.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                        <div class="wf-withheld"><dt>Call-out rate</dt><dd>@record.CallOutRate</dd></div>
                        <div class="wf-withheld"><dt>Technician note</dt><dd>@record.TechnicianNote</dd></div>
                    </dl>
                </div>
            }
            <p class="switchboard-note">Green crossed the boundary. Red never entered the agent's context - not redacted from a larger payload, never selected into one.</p>
        }
        @if (!string.IsNullOrWhiteSpace(_workforceRecordsMessage))
        {
            <p class="status-error">@_workforceRecordsMessage</p>
        }
    </section>

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Simulator Behavior</h2>
            <span class="stamp">@(_behavior is null ? "Unavailable" : $"{_behaviorDelayMs} ms delay")</span>
        </div>
        @if (_behavior is null)
        {
            <p>@(_behaviorMessage ?? "Loading simulator behavior...")</p>
        }
        else
        {
            <div class="stage-switch-actions">
                <label>
                    Command delay (ms, up to 8000)
                    <input type="number" min="0" max="8000" step="250" @bind="_behaviorDelayMs" disabled="@_behaviorBusy" />
                </label>
                <label>
                    <input type="checkbox" @bind="_behaviorTimeout" disabled="@_behaviorBusy" />
                    Simulate timeout
                </label>
                <label>
                    <input type="checkbox" @bind="_behaviorFailure" disabled="@_behaviorBusy" />
                    Simulate failure
                </label>
                <button class="button primary" @onclick="ApplyBehaviorAsync" disabled="@_behaviorBusy">
                    @(_behaviorBusy ? "Applying..." : "Apply behavior")
                </button>
            </div>
            <p class="switchboard-note">These settings reset to defaults whenever a scenario is applied or reset.</p>
            @if (!string.IsNullOrWhiteSpace(_behaviorMessage))
            {
                <p class="@(_behaviorMessageIsError ? "status-error" : string.Empty)">@_behaviorMessage</p>
            }
        }
    </section>

</div>

@code {
    private ScenarioCatalogResponse? _catalog;
    private DemoStageCatalogResponse? _stageCatalog;
    private IReadOnlyList<DemoBreakpointSource>? _breakpoints;
    private bool _breakpointsBusy;
    private string? _breakpointsMessage;
    private VsCodeAttachStatus? _attachStatus;
    private bool _attachBusy;
    private string? _attachMessage;
    private bool _attachMessageIsError;
    private WorkKnowledgeState? _workKnowledge;
    private bool _workKnowledgeBusy;
    private string? _workKnowledgeMessage;
    private CaseMemoryState? _caseMemory;
    private bool _caseMemoryBusy;
    private string? _caseMemoryMessage;
    private ToolSourceState? _toolSource;
    private bool _toolSourceBusy;
    private string? _toolSourceMessage;
    private AgentHabitatState? _agentHabitat;
    private bool _agentHabitatBusy;
    private string? _agentHabitatMessage;
    private SecurityConsultState? _securityConsult;
    private IReadOnlyList<WorkOrderRecord>? _workforceRecords;
    private bool _workforceRecordsBusy;
    private string? _workforceRecordsMessage;
    private bool _securityConsultBusy;
    private string? _securityConsultMessage;
    private SimulatorBehaviorSettings? _behavior;
    private int _behaviorDelayMs;
    private bool _behaviorTimeout;
    private bool _behaviorFailure;
    private bool _behaviorBusy;
    private string? _behaviorMessage;
    private bool _behaviorMessageIsError;
    private string? _message;
    private bool _messageIsError;
    private bool _busy;
    private bool _stageBusy;
    private string? _stageMessage;
    private bool _stageMessageIsError;
    private CancellationTokenSource? _pollingTokenSource;
    private Task? _pollingTask;

    private string StageName => _stageCatalog?.CurrentStage.Name ?? Configuration["DemoStage"] ?? "Deterministic";
    private string WorkKnowledgeStamp => _workKnowledge switch
    {
        null => "Unavailable",
        { EvidencePresent: true } => "Evidence present",
        _ => "No evidence"
    };
    private string CaseMemoryStamp => _caseMemory switch
    {
        null => "Unavailable",
        { Cases.Count: 0 } => "Empty",
        { Cases.Count: var count } => $"{count} case(s)"
    };
    private string WorkforceRecordsButtonLabel => (_workforceRecords, _workforceRecordsBusy) switch
    {
        (not null, _) => "Hide work orders",
        (_, true) => "Loading...",
        _ => "Show work orders in full"
    };

    private string WorkforceRecordsStamp => _workforceRecords is null ? "Hidden" : $"{_workforceRecords.Count} work order(s) in full";

    private string SecurityConsultStamp => _securityConsult switch
    {
        null => "unknown",
        { Enabled: true } => "consulting Security",
        _ => "single agent"
    };
    private string ToolSourceStamp => _toolSource switch
    {
        null => "Unavailable",
        { Source: "Mcp" } => "MCP remote",
        _ => "Local function"
    };
    private string AgentHabitatStamp => _agentHabitat switch
    {
        null => "Unavailable",
        { Habitat: "FoundryHosted" } => "Foundry hosted",
        _ => "Local (Aspire)"
    };
    // Each service is debugged separately, so the panel stamp counts how many are attached rather
    // than claiming a single answer for all of them.
    private string BreakpointStamp => _breakpoints switch
    {
        null => "Unavailable",
        _ => $"{_breakpoints.Count(source => source.DebuggerAttached)}/{_breakpoints.Count} services attached"
    };
    private bool ArmDisabled => _breakpointsBusy || _attachStatus is not { ExtensionInstalled: true };

    private static string SourceStamp(DemoBreakpointSource source) => source switch
    {
        { Error: not null } => "Unavailable",
        { DebuggerAttached: true } => "Debugger attached",
        _ => "Debugger not attached"
    };
    private TimeSpan PollingInterval => TimeSpan.FromSeconds(WebOptions.Value.PollingIntervalSeconds);

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync(CancellationToken.None, showErrors: true);
        await LoadStageCatalogAsync(CancellationToken.None, showErrors: true);
        await LoadBreakpointsAsync(CancellationToken.None);
        await LoadAttachStatusAsync(CancellationToken.None);
        await LoadBehaviorAsync(CancellationToken.None);
        await LoadWorkKnowledgeAsync(CancellationToken.None);
        await LoadCaseMemoryAsync(CancellationToken.None);
        await LoadToolSourceAsync(CancellationToken.None);
        await LoadAgentHabitatAsync(CancellationToken.None);
        await LoadSecurityConsultAsync(CancellationToken.None);

        _pollingTokenSource = new CancellationTokenSource();
        _pollingTask = PollCatalogAsync(_pollingTokenSource.Token);
    }

    private async Task PollCatalogAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollingInterval);

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadCatalogAsync(cancellationToken, showErrors: _catalog is null);
                    await LoadStageCatalogAsync(cancellationToken, showErrors: _stageCatalog is null);
                    await LoadBreakpointsAsync(cancellationToken);
                    await LoadCaseMemoryAsync(cancellationToken);

                    // The tool source can change server-side (a stage downgrade resets it to
                    // Local); keep the toggle truthful without a page action.
                    if (!_toolSourceBusy)
                    {
                        await LoadToolSourceAsync(cancellationToken);
                    }

                    // The habitat resets to Local on a stage downgrade for the same reason.
                    if (!_agentHabitatBusy)
                    {
                        await LoadAgentHabitatAsync(cancellationToken);
                    }

                    if (!_securityConsultBusy)
                    {
                        await LoadSecurityConsultAsync(cancellationToken);
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Normal shutdown path: the polling loop is cancelled when the page is disposed.
        }
    }

    private async Task RefreshAsync()
    {
        await LoadCatalogAsync(CancellationToken.None, showErrors: true);
        await LoadCaseMemoryAsync(CancellationToken.None);
    }

    private async Task ApplyScenarioAsync(ScenarioId scenarioId)
    {
        _busy = true;

        try
        {
            var result = await ApiClient.ApplyScenarioAsync(scenarioId, CancellationToken.None);
            _message = result.Message;
            _messageIsError = !result.Succeeded;
        }
        catch (Exception exception)
        {
            _message = $"Scenario application failed: {exception.Message}";
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
            await LoadCatalogAsync(CancellationToken.None, showErrors: true);
            await LoadBehaviorAsync(CancellationToken.None);
        }
    }

    private async Task ResetAsync()
    {
        _busy = true;

        try
        {
            var result = await ApiClient.ResetAsync(CancellationToken.None);
            _message = result.Message;
            _messageIsError = !result.Succeeded;
        }
        catch (Exception exception)
        {
            _message = $"Reset failed: {exception.Message}";
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
            await LoadCatalogAsync(CancellationToken.None, showErrors: true);
            await LoadBehaviorAsync(CancellationToken.None);
        }
    }

    private async Task ApplyStageAsync(DemoStage stage)
    {
        _stageBusy = true;

        try
        {
            var result = await StageClient.ApplyStageAsync(stage, CancellationToken.None);
            _stageMessage = result.Message;
            _stageMessageIsError = !result.Succeeded;
        }
        catch (Exception exception)
        {
            _stageMessage = $"Stage change failed: {exception.Message}";
            _stageMessageIsError = true;
        }
        finally
        {
            _stageBusy = false;
            await LoadStageCatalogAsync(CancellationToken.None, showErrors: true);
        }
    }

    private async Task LoadCatalogAsync(CancellationToken cancellationToken, bool showErrors)
    {
        try
        {
            _catalog = await ApiClient.GetCatalogAsync(cancellationToken);

            if (!_messageIsError)
            {
                _message = null;
            }
        }
        catch (Exception exception)
        {
            if (showErrors || _catalog is null)
            {
                _message = $"Unable to load the demo scenario catalog: {exception.Message}";
                _messageIsError = true;
            }
        }
    }

    private async Task LoadStageCatalogAsync(CancellationToken cancellationToken, bool showErrors)
    {
        try
        {
            _stageCatalog = await StageClient.GetCatalogAsync(cancellationToken);

            if (!_stageMessageIsError)
            {
                _stageMessage = null;
            }
        }
        catch (Exception exception)
        {
            if (showErrors || _stageCatalog is null)
            {
                _stageMessage = $"Unable to load the demo stage catalog: {exception.Message}";
                _stageMessageIsError = true;
            }
        }
    }

    private async Task LoadBreakpointsAsync(CancellationToken cancellationToken)
    {
        try
        {
            _breakpoints = await BreakpointsClient.GetStatusAsync(cancellationToken);
            _breakpointsMessage = null;
