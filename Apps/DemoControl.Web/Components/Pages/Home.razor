    private Task RequestAttachAsync(string processName) => RequestDebuggerChangeAsync(processName, attach: true);

    private Task RequestDetachAsync(string processName) => RequestDebuggerChangeAsync(processName, attach: false);

    private async Task RequestDebuggerChangeAsync(string processName, bool attach)
    {
        if (!_attachBusyProcesses.Add(processName))
        {
            return;
        }

        try
        {
            var result = attach
                ? await AttachService.RequestAttachAsync(processName, CancellationToken.None)
                : await AttachService.RequestDetachAsync(processName, CancellationToken.None);
            _attachMessage = result.Message;
            _attachMessageIsError = !result.Succeeded;

            if (!result.Succeeded)
            {
                return;
            }

            // The URL was handed to VS Code, which attaches or detaches on its own time. The
            // service's own report is the only truth about whether a debugger is on it, so it is
            // polled until it agrees or the wait runs out - and a wait that runs out says so,
            // because a button that silently did nothing is the failure this replaces.
            var settled = await WaitForDebuggerStateAsync(processName, attach, TimeSpan.FromSeconds(15));
            var serviceName = FindBreakpointSource(processName)?.Service.DisplayName ?? processName;
            _attachMessage = (attach, settled) switch
            {
                (true, true) => $"Debugger attached to {serviceName}.",
                (false, true) => $"Debugger detached from {serviceName}; the service keeps running.",
                (true, false) => $"{serviceName} has not reported a debugger within 15 seconds. Check the VS Code notification.",
                (false, false) => $"{serviceName} still reports a debugger after 15 seconds. Check the VS Code notification."
            };
            _attachMessageIsError = !settled;
        }
        finally
        {
            _attachBusyProcesses.Remove(processName);
            await LoadBreakpointsAsync(CancellationToken.None);
        }
    }

    private async Task<bool> WaitForDebuggerStateAsync(string processName, bool attached, TimeSpan timeout)
    {
        var deadline = DateTimeOffset.UtcNow + timeout;

        while (DateTimeOffset.UtcNow < deadline)
        {
            await Task.Delay(TimeSpan.FromMilliseconds(500));
            await LoadBreakpointsAsync(CancellationToken.None);

            if (FindBreakpointSource(processName) is { Error: null } source && source.DebuggerAttached == attached)
            {
                return true;
            }

            StateHasChanged();
        }

        return false;
    }

    private DemoBreakpointSource? FindBreakpointSource(string processName) =>
        _breakpoints?.FirstOrDefault(source => string.Equals(source.Service.ProcessName, processName, StringComparison.OrdinalIgnoreCase));

    private async Task SetBreakpointAsync(string clientName, string snippetName, bool armed)
    {
        _breakpointsBusy = true;

        try
        {
            // The arm goes to the owning service; the panel then re-reads every service so the
            // other rows stay truthful too.
            await BreakpointsClient.SetArmedAsync(clientName, snippetName, armed, CancellationToken.None);
            await LoadBreakpointsAsync(CancellationToken.None);
            _breakpointsMessage = null;
        }
        catch (Exception exception)
        {
            _breakpointsMessage = $"Breakpoint change failed: {exception.Message}";
        }
        finally
        {
            _breakpointsBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_pollingTokenSource is null)
        {
            return;
        }

        await _pollingTokenSource.CancelAsync();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
                // Normal shutdown path: the polling task ends by cancellation during dispose.
            }
        }

        _pollingTokenSource.Dispose();
    }
}
