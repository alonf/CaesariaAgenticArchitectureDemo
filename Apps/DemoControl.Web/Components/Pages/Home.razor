    private TimeSpan PollingInterval => TimeSpan.FromSeconds(WebOptions.Value.PollingIntervalSeconds);

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync(CancellationToken.None, showErrors: true);
        await LoadStageCatalogAsync(CancellationToken.None, showErrors: true);
        await LoadBreakpointsAsync(CancellationToken.None);
        await LoadAttachStatusAsync(CancellationToken.None);
        await LoadBehaviorAsync(CancellationToken.None);
        await LoadWorkKnowledgeAsync(CancellationToken.None);
        await LoadCaseMemoryAsync(CancellationToken.None);
        await LoadToolSourceAsync(CancellationToken.None);
        await LoadAgentHabitatAsync(CancellationToken.None);
        await LoadSecurityConsultAsync(CancellationToken.None);

        _pollingTokenSource = new CancellationTokenSource();
        _pollingTask = PollCatalogAsync(_pollingTokenSource.Token);
    }

    private async Task PollCatalogAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollingInterval);

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadCatalogAsync(cancellationToken, showErrors: _catalog is null);
                    await LoadStageCatalogAsync(cancellationToken, showErrors: _stageCatalog is null);
                    await LoadBreakpointsAsync(cancellationToken);
                    await LoadCaseMemoryAsync(cancellationToken);

                    // The tool source can change server-side (a stage downgrade resets it to
                    // Local); keep the toggle truthful without a page action.
                    if (!_toolSourceBusy)
                    {
                        await LoadToolSourceAsync(cancellationToken);
                    }

                    // The habitat resets to Local on a stage downgrade for the same reason.
                    if (!_agentHabitatBusy)
                    {
                        await LoadAgentHabitatAsync(cancellationToken);
                    }

                    if (!_securityConsultBusy)
                    {
                        await LoadSecurityConsultAsync(cancellationToken);
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Normal shutdown path: the polling loop is cancelled when the page is disposed.
        }
    }

