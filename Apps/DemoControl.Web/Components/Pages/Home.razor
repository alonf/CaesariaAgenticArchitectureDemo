@page "/"
@implements IAsyncDisposable
@inject DemoScenarioApiClient ApiClient
@inject DemoStageApiClient StageClient
@inject DemoBreakpointsApiClient BreakpointsClient
@inject VsCodeAttachService AttachService
@inject IConfiguration Configuration
@inject IOptions<DemoControlWebOptions> WebOptions

<PageTitle>Caesarea Demo Control</PageTitle>

<div class="page-shell">
    <header class="hero">
        <div>
            <p class="eyebrow">Presenter Only</p>
            <h1>Deterministic Scenario Control</h1>
            <p class="subtitle">Use the six curated Stage 0 scenarios to drive the Energy and Command Center vertical slice. Stage: @StageName.</p>
        </div>
        <div class="hero-actions">
            <button class="button secondary" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
            <button class="button primary" @onclick="ResetAsync" disabled="@_busy">Reset to Normal Operation</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <section class="message-banner @(_messageIsError ? "error" : "success")">
            <strong>@(_messageIsError ? "Attention:" : "Update:")</strong>
            <span>@_message</span>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_stageMessage))
    {
        <section class="message-banner @(_stageMessageIsError ? "error" : "success")">
            <strong>@(_stageMessageIsError ? "Attention:" : "Update:")</strong>
            <span>@_stageMessage</span>
        </section>
    }

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Presenter Switchboard</h2>
            <span class="stamp">@(_stageCatalog is null ? "Loading..." : _stageCatalog.CurrentStage.AppliedAt.ToLocalTime().ToString("HH:mm:ss"))</span>
        </div>
        @if (_stageCatalog is null)
        {
            <p>Loading demo stage catalog...</p>
        }
        else
        {
            <p>
                Current stage: <strong>@_stageCatalog.CurrentStage.Name</strong> - @_stageCatalog.CurrentStage.Description
            </p>
            <ul class="capability-list">
                @foreach (var capability in _stageCatalog.CurrentStage.Capabilities)
                {
                    <li>@capability</li>
                }
            </ul>
            <div class="stage-switch-actions">
                @foreach (var stage in _stageCatalog.Stages)
                {
                    <button
                        class="button @(stage.Id == _stageCatalog.CurrentStage.Id ? "primary" : "secondary")"
                        @onclick="() => ApplyStageAsync(stage.Id)"
                        disabled="@_stageBusy">
                        @stage.Name
                    </button>
                }
            </div>
            <p class="switchboard-note">Resetting to Normal Operation preserves the currently selected stage.</p>
        }
    </section>

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Demo Breakpoints</h2>
            <span class="stamp">@BreakpointStamp</span>
        </div>
        @if (_breakpoints is null)
        {
            <p>@(_breakpointsMessage ?? "Loading demo breakpoints...")</p>
        }
        else
        {
            <p>Arm a snippet to pause the Operations Agent service at that code on its next run, then single-step it in the editor.</p>
            <ul class="capability-list">
                @foreach (var snippet in _breakpoints.Snippets)
                {
                    <li>
                        <label>
                            <input
                                type="checkbox"
                                checked="@snippet.IsArmed"
                                disabled="@ArmDisabled"
                                @onchange="e => SetBreakpointAsync(snippet.SnippetName, e.Value is true)" />
                            @snippet.SnippetName - break on next run
                        </label>
                    </li>
                }
            </ul>
            <div class="stage-switch-actions">
                @if (_attachStatus is { VsCodeAvailable: true, ExtensionInstalled: false })
                {
                    <button class="button primary" @onclick="InstallExtensionAsync" disabled="@_attachBusy">
                        @(_attachBusy ? "Installing..." : "Install VS Code extension")
                    </button>
                }
                else if (_attachStatus is { ExtensionInstalled: true } && !_breakpoints.DebuggerAttached)
                {
                    <button class="button primary" @onclick="RequestAttachAsync" disabled="@_attachBusy">
                        @(_attachBusy ? "Requesting..." : "Attach debugger")
                    </button>
                }
            </div>
            @if (_attachStatus is { VsCodeAvailable: false })
            {
                <p class="switchboard-note">The VS Code CLI was not found on this machine; breakpoint arming is unavailable.</p>
            }
            else if (_attachStatus is { ExtensionInstalled: false })
            {
                <p class="switchboard-note">Breakpoint arming is disabled until the demo-attach VS Code extension is installed.</p>
            }
            else if (!_breakpoints.DebuggerAttached)
            {
                <p class="switchboard-note">Armed snippets stay armed until a debugged run consumes them.</p>
            }
        }
        @if (!string.IsNullOrWhiteSpace(_attachMessage))
        {
            <p class="@(_attachMessageIsError ? "status-error" : string.Empty)">@_attachMessage</p>
        }
    </section>

    <section class="panel switchboard-panel">
        <div class="panel-heading">
            <h2>Simulator Behavior</h2>
            <span class="stamp">@(_behavior is null ? "Unavailable" : $"{_behaviorDelayMs} ms delay")</span>
        </div>
        @if (_behavior is null)
        {
            <p>@(_behaviorMessage ?? "Loading simulator behavior...")</p>
        }
        else
        {
            <div class="stage-switch-actions">
                <label>
                    Command delay (ms, up to 8000)
                    <input type="number" min="0" max="8000" step="250" @bind="_behaviorDelayMs" disabled="@_behaviorBusy" />
                </label>
                <label>
                    <input type="checkbox" @bind="_behaviorTimeout" disabled="@_behaviorBusy" />
                    Simulate timeout
                </label>
                <label>
                    <input type="checkbox" @bind="_behaviorFailure" disabled="@_behaviorBusy" />
                    Simulate failure
                </label>
                <button class="button primary" @onclick="ApplyBehaviorAsync" disabled="@_behaviorBusy">
                    @(_behaviorBusy ? "Applying..." : "Apply behavior")
                </button>
            </div>
            <p class="switchboard-note">These settings reset to defaults whenever a scenario is applied or reset.</p>
            @if (!string.IsNullOrWhiteSpace(_behaviorMessage))
            {
                <p class="@(_behaviorMessageIsError ? "status-error" : string.Empty)">@_behaviorMessage</p>
            }
        }
    </section>

    @if (_catalog is null)
    {
        <section class="panel empty-state">
            <p>Loading scenario catalog...</p>
        </section>
    }
    else
    {
        <section class="panel current-panel">
            <div class="panel-heading">
                <h2>Current Scenario</h2>
                <span class="stamp">@_catalog.CurrentScenario.AppliedAt.ToLocalTime().ToString("HH:mm:ss")</span>
            </div>
            <strong class="scenario-name">@_catalog.CurrentScenario.Name</strong>
            <p>@_catalog.CurrentScenario.Description</p>
            <p><strong>Status:</strong> @_catalog.CurrentScenario.ApplicationStatus</p>
            @if (!string.IsNullOrWhiteSpace(_catalog.CurrentScenario.FailureSummary))
            {
                <p class="status-error">@_catalog.CurrentScenario.FailureSummary</p>
            }
        </section>

        <section class="scenario-grid">
            @foreach (var scenario in _catalog.Scenarios)
            {
                <article class="panel scenario-card @(scenario.Id == _catalog.CurrentScenario.Id ? "active" : string.Empty)">
                    <span class="card-tag">@scenario.Id</span>
                    <h2>@scenario.Name</h2>
                    <p>@scenario.Description</p>
                    <button class="button secondary" @onclick="() => ApplyScenarioAsync(scenario.Id)" disabled="@_busy">
                        Apply Scenario
                    </button>
                </article>
            }
        </section>
    }
</div>

@code {
    private ScenarioCatalogResponse? _catalog;
    private DemoStageCatalogResponse? _stageCatalog;
    private DemoBreakpointsResponse? _breakpoints;
    private bool _breakpointsBusy;
    private string? _breakpointsMessage;
    private VsCodeAttachStatus? _attachStatus;
    private bool _attachBusy;
    private string? _attachMessage;
    private bool _attachMessageIsError;
    private SimulatorBehaviorSettings? _behavior;
    private int _behaviorDelayMs;
    private bool _behaviorTimeout;
    private bool _behaviorFailure;
    private bool _behaviorBusy;
    private string? _behaviorMessage;
    private bool _behaviorMessageIsError;
    private string? _message;
    private bool _messageIsError;
    private bool _busy;
    private bool _stageBusy;
    private string? _stageMessage;
    private bool _stageMessageIsError;
    private CancellationTokenSource? _pollingTokenSource;
    private Task? _pollingTask;

    private string StageName => _stageCatalog?.CurrentStage.Name ?? Configuration["DemoStage"] ?? "Deterministic";
    private string BreakpointStamp => _breakpoints switch
    {
        null => "Unavailable",
        { DebuggerAttached: true } => "Debugger attached",
        _ => "Debugger not attached"
    };
    private bool ArmDisabled => _breakpointsBusy || _attachStatus is not { ExtensionInstalled: true };
    private TimeSpan PollingInterval => TimeSpan.FromSeconds(WebOptions.Value.PollingIntervalSeconds);

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync(CancellationToken.None, showErrors: true);
        await LoadStageCatalogAsync(CancellationToken.None, showErrors: true);
        await LoadBreakpointsAsync(CancellationToken.None);
        await LoadAttachStatusAsync(CancellationToken.None);
        await LoadBehaviorAsync(CancellationToken.None);

        _pollingTokenSource = new CancellationTokenSource();
        _pollingTask = PollCatalogAsync(_pollingTokenSource.Token);
    }

    private async Task PollCatalogAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollingInterval);

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadCatalogAsync(cancellationToken, showErrors: _catalog is null);
                    await LoadStageCatalogAsync(cancellationToken, showErrors: _stageCatalog is null);
                    await LoadBreakpointsAsync(cancellationToken);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Normal shutdown path: the polling loop is cancelled when the page is disposed.
        }
    }

    private async Task RefreshAsync()
    {
        await LoadCatalogAsync(CancellationToken.None, showErrors: true);
    }

    private async Task ApplyScenarioAsync(ScenarioId scenarioId)
    {
        _busy = true;

        try
        {
            var result = await ApiClient.ApplyScenarioAsync(scenarioId, CancellationToken.None);
            _message = result.Message;
            _messageIsError = !result.Succeeded;
        }
        catch (Exception exception)
        {
            _message = $"Scenario application failed: {exception.Message}";
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
            await LoadCatalogAsync(CancellationToken.None, showErrors: true);
            await LoadBehaviorAsync(CancellationToken.None);
        }
    }

    private async Task ResetAsync()
    {
        _busy = true;

        try
        {
            var result = await ApiClient.ResetAsync(CancellationToken.None);
            _message = result.Message;
            _messageIsError = !result.Succeeded;
        }
        catch (Exception exception)
        {
            _message = $"Reset failed: {exception.Message}";
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
            await LoadCatalogAsync(CancellationToken.None, showErrors: true);
            await LoadBehaviorAsync(CancellationToken.None);
        }
    }

    private async Task ApplyStageAsync(DemoStage stage)
    {
        _stageBusy = true;

        try
        {
            var result = await StageClient.ApplyStageAsync(stage, CancellationToken.None);
            _stageMessage = result.Message;
            _stageMessageIsError = !result.Succeeded;
        }
        catch (Exception exception)
        {
            _stageMessage = $"Stage change failed: {exception.Message}";
            _stageMessageIsError = true;
        }
        finally
        {
            _stageBusy = false;
            await LoadStageCatalogAsync(CancellationToken.None, showErrors: true);
        }
    }

    private async Task LoadCatalogAsync(CancellationToken cancellationToken, bool showErrors)
    {
        try
        {
            _catalog = await ApiClient.GetCatalogAsync(cancellationToken);

            if (!_messageIsError)
            {
                _message = null;
            }
        }
        catch (Exception exception)
        {
            if (showErrors || _catalog is null)
            {
                _message = $"Unable to load the demo scenario catalog: {exception.Message}";
                _messageIsError = true;
            }
        }
    }

    private async Task LoadStageCatalogAsync(CancellationToken cancellationToken, bool showErrors)
    {
        try
        {
            _stageCatalog = await StageClient.GetCatalogAsync(cancellationToken);

            if (!_stageMessageIsError)
            {
                _stageMessage = null;
            }
        }
        catch (Exception exception)
        {
            if (showErrors || _stageCatalog is null)
            {
                _stageMessage = $"Unable to load the demo stage catalog: {exception.Message}";
                _stageMessageIsError = true;
            }
        }
    }

    private async Task LoadBreakpointsAsync(CancellationToken cancellationToken)
    {
        try
        {
            _breakpoints = await BreakpointsClient.GetStatusAsync(cancellationToken);
            _breakpointsMessage = null;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _breakpoints = null;
            _breakpointsMessage = $"Demo breakpoints unavailable: {exception.Message}";
        }
    }

    private async Task LoadBehaviorAsync(CancellationToken cancellationToken)
    {
        try
        {
            _behavior = await ApiClient.GetSimulatorBehaviorAsync(cancellationToken);
            _behaviorDelayMs = _behavior.CommandDelayMs;
            _behaviorTimeout = _behavior.SimulateTimeout;
            _behaviorFailure = _behavior.SimulateFailure;

            if (!_behaviorMessageIsError)
            {
                _behaviorMessage = null;
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _behavior = null;
            _behaviorMessage = $"Simulator behavior unavailable: {exception.Message}";
            _behaviorMessageIsError = true;
        }
    }

    private async Task ApplyBehaviorAsync()
    {
        _behaviorBusy = true;

        try
        {
            var result = await ApiClient.UpdateSimulatorBehaviorAsync(
                new SimulatorBehaviorSettings(_behaviorDelayMs, _behaviorTimeout, _behaviorFailure),
                CancellationToken.None);
            _behaviorMessage = result.Message;
            _behaviorMessageIsError = !result.Succeeded;
        }
        finally
        {
            _behaviorBusy = false;
            await LoadBehaviorAsync(CancellationToken.None);
        }
    }

    private async Task LoadAttachStatusAsync(CancellationToken cancellationToken)
    {
        try
        {
            _attachStatus = await AttachService.GetStatusAsync(cancellationToken);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _attachStatus = new VsCodeAttachStatus(VsCodeAvailable: false, ExtensionInstalled: false);
            _attachMessage = $"VS Code status check failed: {exception.Message}";
            _attachMessageIsError = true;
        }
    }

    private async Task InstallExtensionAsync()
    {
        _attachBusy = true;

        try
        {
            var result = await AttachService.InstallExtensionAsync(CancellationToken.None);
            _attachMessage = result.Message;
            _attachMessageIsError = !result.Succeeded;
        }
        finally
        {
            _attachBusy = false;
            await LoadAttachStatusAsync(CancellationToken.None);
        }
    }

    private async Task RequestAttachAsync()
    {
        _attachBusy = true;

        try
        {
            var result = await AttachService.RequestAttachAsync(CancellationToken.None);
            _attachMessage = result.Message;
            _attachMessageIsError = !result.Succeeded;
        }
        finally
        {
            _attachBusy = false;
            await LoadBreakpointsAsync(CancellationToken.None);
        }
    }

    private async Task SetBreakpointAsync(string snippetName, bool armed)
    {
        _breakpointsBusy = true;

        try
        {
            _breakpoints = await BreakpointsClient.SetArmedAsync(snippetName, armed, CancellationToken.None);
            _breakpointsMessage = null;
        }
        catch (Exception exception)
        {
            _breakpointsMessage = $"Breakpoint change failed: {exception.Message}";
        }
        finally
        {
            _breakpointsBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_pollingTokenSource is null)
        {
            return;
        }

        await _pollingTokenSource.CancelAsync();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
                // Normal shutdown path: the polling task ends by cancellation during dispose.
            }
        }

        _pollingTokenSource.Dispose();
    }
}
