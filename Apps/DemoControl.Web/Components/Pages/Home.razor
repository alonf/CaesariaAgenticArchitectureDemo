    private async Task LoadBehaviorAsync(CancellationToken cancellationToken)
    {
        try
        {
            _behavior = await ApiClient.GetSimulatorBehaviorAsync(cancellationToken);
            _behaviorDelayMs = _behavior.CommandDelayMs;
            _behaviorTimeout = _behavior.SimulateTimeout;
            _behaviorFailure = _behavior.SimulateFailure;

            if (!_behaviorMessageIsError)
            {
                _behaviorMessage = null;
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _behavior = null;
            _behaviorMessage = $"Simulator behavior unavailable: {exception.Message}";
            _behaviorMessageIsError = true;
        }
    }

    private async Task ApplyBehaviorAsync()
    {
        _behaviorBusy = true;

        try
        {
            var result = await ApiClient.UpdateSimulatorBehaviorAsync(
                new SimulatorBehaviorSettings(_behaviorDelayMs, _behaviorTimeout, _behaviorFailure),
                CancellationToken.None);
            _behaviorMessage = result.Message;
            _behaviorMessageIsError = !result.Succeeded;
        }
        finally
        {
            _behaviorBusy = false;
            await LoadBehaviorAsync(CancellationToken.None);
        }
    }

