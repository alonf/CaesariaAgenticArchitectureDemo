<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>caesarea-operations-hosted</UserSecretsId>
    <!-- The hosting platform runs linux/amd64 only. -->
    <ContainerFamily>noble</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.20.0-preview.260831.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same instructions, the same tools, the same skills. Sharing the code rather than
         copying it is what makes "same agent, different habitat" a true statement rather than a
         claim on a slide. -->
    <ProjectReference Include="..\OperationsAgent.Api\OperationsAgent.Api.csproj" />
  </ItemGroup>

  <!-- Publishing a web project also collects the content of every web project it references, so
       OperationsAgent.Api's appsettings.json arrives at the same relative path as this project's and
       the SDK stops with NETSDK1152.

       The tempting one-line fix, ErrorOnDuplicatePublishOutputFiles=false, is the wrong one: it does
       not choose, it just stops complaining, and if the Api's file wins then this container boots
       with another habitat's configuration - an Energy Hub address and a model deployment that mean
       nothing here. Drop the referenced project's copies and keep our own, which is deterministic
       and says out loud which file is meant to survive. -->
  <Target Name="RemoveReferencedProjectSettingsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('appsettings')) And
                   $([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Replace('\', '/').Contains('/OperationsAgent.Api/'))" />
    </ItemGroup>
  </Target>

</Project>
