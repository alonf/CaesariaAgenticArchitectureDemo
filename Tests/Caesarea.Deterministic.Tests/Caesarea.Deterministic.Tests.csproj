    <ProjectReference Include="..\..\Contracts\DemoScenario.Contracts\DemoScenario.Contracts.csproj" />
    <ProjectReference Include="..\..\Contracts\Energy.Contracts\Energy.Contracts.csproj" />
    <ProjectReference Include="..\..\Contracts\OperationsAgent.Contracts\OperationsAgent.Contracts.csproj" />
    <ProjectReference Include="..\..\Contracts\SmartPole.Contracts\SmartPole.Contracts.csproj" />
    <ProjectReference Include="..\..\Services\CommandCenter.Api\CommandCenter.Api.csproj" />
