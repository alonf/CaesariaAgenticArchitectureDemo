{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "deploymentPrincipalId": { "value": "${AZURE_DEPLOYMENT_PRINCIPAL_ID}" },
    "modelVersion": { "value": "${AZURE_MODEL_VERSION}" },
    "modelName": { "value": "${AZURE_MODEL_NAME=gpt-5.5}" },
    "modelDeploymentName": { "value": "${AZURE_MODEL_DEPLOYMENT_NAME=gpt-5.5}" },
    "publicNetworkAccess": { "value": "${AZURE_PUBLIC_NETWORK_ACCESS=true}" }
  }
}
